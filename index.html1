/* ---------- trees (yard + neighborhood) ---------- */
const treeObjs = [], AUTUMN_COLORS = [0xd9822b, 0xc0392b, 0xe0b030, 0xb5651d, 0xcf6a1f, 0xd19a1f, 0xa8442a, 0xdca02a];
const outerTrees = [];
function buildTree(x, z, ti, outerT) {
  const g = new THREE.Group(); g.position.set(x, 0, z); g.scale.setScalar(outerT ? rr(.95, 1.25) : 1); scene.add(g);
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(.22, .45, 4.8, 10), M.bark); trunk.position.y = 2.4; trunk.castShadow = true; g.add(trunk);
  const flare = new THREE.Mesh(new THREE.CylinderGeometry(.45, .75, .5, 10), M.bark); flare.position.y = .25; g.add(flare);
  const fm = std({ color: 0x2f7d32, roughness: .85, vertexColors: true }), fol = new THREE.Group(); fol.position.y = 5.6; g.add(fol);
  const nb = outerT ? 4 : 8;
  for (let k = 0; k < nb; k++) { const r = rr(1.5, 2.3), b = new THREE.Mesh(jitterGeo(new THREE.IcosahedronGeometry(r, outerT ? 1 : 2), ti * 7 + k, .17, true), fm); b.position.set(rr(-1.8, 1.8), rr(-.5, 2), rr(-1.8, 1.8)); b.castShadow = !outerT; b.receiveShadow = true; fol.add(b); }
  const branches = new THREE.Group(); branches.position.y = 4.3; g.add(branches); const caps = [];
  for (let k = 0; k < (outerT ? 4 : 7); k++) {
    const len = rr(2, 3), geo = new THREE.CylinderGeometry(.03, .09, len, 6); geo.translate(0, len / 2, 0);
    const br = new THREE.Mesh(geo, M.bark); br.rotation.order = 'YZX'; br.rotation.set(0, k * 1.0, rr(.7, 1.1)); br.castShadow = !outerT; branches.add(br);
    const cap = new THREE.Mesh(new THREE.SphereGeometry(.3, 8, 6), M.snow); cap.scale.set(1, .35, 1); cap.position.set(0, len * .7, .08); br.add(cap); caps.push(cap);
  }
  const mound = new THREE.Mesh(new THREE.SphereGeometry(1, 12, 6), M.snow); mound.scale.set(1.3, .1, 1.3); mound.position.y = .02; g.add(mound);
  const o = { g, fm, fol, branches, caps, mound, autumn: AUTUMN_COLORS[ti % AUTUMN_COLORS.length], ph: rr(0, 6) }; treeObjs.push(o); return o;
}
