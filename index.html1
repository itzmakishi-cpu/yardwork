/* ---------- containers (sack, wheelbarrow) ---------- */
const C = {
  sack:   { own: false, x: 0, z: 0, load: { type: null, n: 0 }, cap: () => stats().sackCap,   mesh: null },
  barrow: { own: false, x: 0, z: 0, load: { type: null, n: 0 }, cap: () => stats().barrowCap, mesh: null }
};
const units = l => (l.type && l.n > 0) ? l.n * W[l.type] : 0;
const canAdd = (l, t, cap, amt = 1) => (!l.type || l.n < 1e-4 || l.type === t) && units(l) + W[t] * amt <= cap + 1e-6;
function capOf(t) { const st = stats(); if (t === 'snow' && G.tool === 4) return st.shovCap; if (t === 'grass' && G.tool === 5) return st.mowCap; return st.handCap; }
function addLoad(t, amt = 1) {
  if (canAdd(G.load, t, capOf(t), amt)) { G.load.type = t; G.load.n += amt; return true; }
  if (t !== 'snow') for (const k of ['sack', 'barrow']) { const c = C[k]; if (c.own && G.held !== k && Math.hypot(P.x - c.x, P.z - c.z) < 3.4 && canAdd(c.load, t, c.cap(), amt)) { c.load.type = t; c.load.n += amt; return true; } }
  return false;
}
const anyLoad = t => (G.load.type === t ? G.load.n : 0) + ['sack', 'barrow'].reduce((s, k) => s + (C[k].load.type === t ? C[k].load.n : 0), 0);
function syncContainer(k) {
  const c = C[k]; if (!c.mesh) return; const fill = clamp(units(c.load) / c.cap(), 0, 1), col = c.load.type === 'leaf' ? 0xb4682a : c.load.type === 'grass' ? 0x4f9a3a : 0xf0f4ff;
  if (k === 'sack') { c.mesh.userData.body.scale.set(1 + .15 * fill, 1.25 + .2 * fill, .8 + .25 * fill); c.mesh.userData.body.material.color.setHex(fill > .02 ? (c.load.type === 'leaf' ? 0xb08a56 : 0x9fa86a) : 0xb89a62); }
  else { const p = c.mesh.userData.pile; p.scale.set(1, .1 + fill * 1.1, 1.2); p.position.y = .74 + fill * .1; p.material.color.setHex(col); p.visible = fill > .01; }
}
function spawnContainer(k) {
  const c = C[k]; c.own = true; c.mesh = MODELS[k](); c.mesh.traverse(o => { if (o.isMesh) o.castShadow = true; }); scene.add(c.mesh);
  const fx = -Math.sin(P.yaw), fz = -Math.cos(P.yaw); c.x = clamp(P.x + fx * 1.8, -22.5, 22.5); c.z = clamp(P.z + fz * 1.8, -22.5, 22.5); c.mesh.position.set(c.x, 0, c.z); syncContainer(k);
}

/* ---------- first-person tool models ---------- */
const FPBASE = { hands: [0, -.46, -.45, 0, 0, 0], scissors: [.28, -.28, -.45, -.3, -.2, 0], rake: [.36, -.42, -.6, -.5, -.15, 0], blower: [.3, -.3, -.55, -.1, .05, 0], shovel: [.34, -.4, -.55, -.55, -.12, 0], mower: [0, -1.66, -1.75, 0, 0, 0], seeder: [.2, -1.1, -1.2, 0, 0, 0], can: [.32, -.34, -.62, 0, .15, 0] };
const tools = TOOLKEY.map(k => { const g = MODELS[k](); g.userData.base = FPBASE[k]; g.visible = false; g.traverse(o => { if (o.isMesh) o.castShadow = false; }); camera.add(g); return g; });
