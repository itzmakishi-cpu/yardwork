<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Yardwork: Four Seasons</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#eef2f5;--mute:#a9b5bf;--panel:rgba(13,21,29,.76);--line:rgba(255,255,255,.14);--hi:#f2b632;--bad:#ff7a6b;--good:#8fdcae;
  font-family:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#0b1118;color:var(--ink)}
#c{position:fixed;inset:0;width:100%;height:100%;display:block;outline:none}
#vig{position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at center,transparent 58%,rgba(0,0,0,.38) 100%);z-index:1}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;backdrop-filter:blur(6px);padding:10px 14px}
.num{font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;letter-spacing:.01em}
#hud{position:fixed;inset:0;pointer-events:none;display:none;z-index:2}
#season{position:absolute;left:18px;top:18px;width:300px}
#seasonName{font-size:26px;line-height:1}
#roundLine{color:var(--mute);font-size:14px;margin-top:4px}
.bar{height:8px;background:rgba(255,255,255,.12);border-radius:5px;overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;width:0;background:var(--hi);transition:width .25s}
#timer{margin-top:6px;font-size:15px;color:var(--mute)}
#timer.low{color:var(--bad)}
#wallet{position:absolute;right:18px;top:18px;text-align:right;min-width:170px}
#money{font-size:34px;line-height:1}
#debt{font-size:14px;color:var(--bad);margin-top:4px;display:none}
#stats{position:absolute;left:18px;bottom:18px;width:290px;display:grid;gap:9px}
.stat .lab{display:flex;justify-content:space-between;font-size:13px;color:var(--mute);margin-bottom:3px}
.stat .lab b{color:var(--ink);font-weight:600}
.stat .bar{margin-top:0}
.stat.hide{display:none}
#hotbar{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);display:flex;gap:8px}
.slot{min-width:84px;padding:7px 8px 8px;text-align:center;border-radius:10px;background:var(--panel);border:1px solid var(--line);position:relative}
.slot .k{font-size:12px;color:var(--mute)}
.slot .n{font-size:15px;line-height:1.1;margin-top:2px;white-space:nowrap}
.slot.on{border-color:var(--hi);box-shadow:0 0 0 1px var(--hi) inset;background:rgba(242,182,50,.16)}
.slot.need::after{content:"";position:absolute;right:7px;top:7px;width:7px;height:7px;border-radius:50%;background:var(--hi)}
#cross{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px;border-radius:50%;background:rgba(255,255,255,.85);box-shadow:0 0 0 1px rgba(0,0,0,.5)}
#prompt{position:absolute;left:50%;top:62%;transform:translateX(-50%);padding:8px 16px;border-radius:8px;background:var(--panel);border:1px solid var(--line);font-size:17px;display:none;text-align:center;line-height:1.7}
#prompt kbd{background:var(--hi);color:#1a1405;border-radius:5px;padding:1px 8px;font-weight:700;margin-right:8px}
#prompt div+div{font-size:15px;color:var(--mute)}
#toasts{position:absolute;right:18px;top:100px;display:grid;gap:6px;justify-items:end}
.toast{padding:8px 14px;border-radius:8px;background:var(--panel);border:1px solid var(--line);font-size:15px;animation:toast 3.6s forwards;max-width:420px;text-align:right}
.toast.good{border-color:var(--good)}.toast.bad{border-color:var(--bad)}
@keyframes toast{0%{opacity:0;transform:translateY(-6px)}8%{opacity:1;transform:none}85%{opacity:1}100%{opacity:0}}
#banner{position:absolute;left:0;right:0;top:20%;text-align:center;opacity:0;pointer-events:none}
#banner h1{font-size:76px;line-height:1;text-shadow:0 3px 24px rgba(0,0,0,.55)}
#banner p{font-size:22px;margin-top:8px;text-shadow:0 2px 12px rgba(0,0,0,.6)}
#banner.show{animation:banner 3.2s forwards}
@keyframes banner{0%{opacity:0;transform:scale(.96)}12%{opacity:1;transform:none}75%{opacity:1}100%{opacity:0}}
.overlay{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,10,14,.66);z-index:10;padding:16px}
.overlay.show{display:flex}
#title{background:linear-gradient(180deg,rgba(6,10,14,.35),rgba(6,10,14,.82))}
.card{background:#111c26;border:1px solid var(--line);border-radius:14px;padding:26px 30px;max-width:700px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.5);max-height:92vh;overflow:auto}
.card h1{font-size:54px;line-height:1}
.card h2{font-size:30px;line-height:1.05}
.card p{color:var(--mute);line-height:1.45;margin-top:10px;font-size:16px}
.keys{display:grid;grid-template-columns:1fr 1fr;gap:6px 22px;margin:18px 0;font-size:15px}
.keys span{color:var(--mute)}
.keys b{color:var(--hi);font-weight:600}
button{font:inherit;cursor:pointer;border:0;border-radius:9px;padding:10px 18px;background:var(--hi);color:#1a1405;font-weight:700;font-size:16px}
button:hover:not(:disabled){filter:brightness(1.1)}
button:disabled{background:#2a3743;color:#6e7c88;cursor:not-allowed}
button.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.tabs{display:flex;gap:8px;margin:16px 0 8px;flex-wrap:wrap}
.tabs button{background:transparent;color:var(--mute);border:1px solid var(--line);padding:7px 14px}
.tabs button.on{color:#1a1405;background:var(--hi);border-color:var(--hi)}
.row{display:grid;grid-template-columns:1fr auto 96px;gap:14px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}
.row b{display:block;font-size:16px}.row span{display:block;color:var(--mute);font-size:13px;margin-top:2px}
.pips{display:flex;gap:4px}.pips i{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.16)}.pips i.f{background:var(--hi)}
.bank{display:grid;gap:12px;margin-top:10px}
.bank .line{display:flex;justify-content:space-between;font-size:17px}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.speech{margin-top:12px;padding:12px 16px;border-radius:12px;background:#1b2b39;border:1px solid var(--line);font-size:17px;line-height:1.45;position:relative}
.speech b{color:var(--hi)}
#fade{position:fixed;inset:0;background:#000;opacity:0;pointer-events:none;transition:opacity .6s;z-index:9}
#fade.on{opacity:1}
@media (max-width:900px){.slot{min-width:56px}.slot .n{font-size:12px}#banner h1{font-size:44px}#season,#stats{width:230px}}
</style>
</head>
<body>
<canvas id="c" tabindex="0"></canvas>
<div id="vig"></div>

<div id="hud">
  <div id="season" class="panel">
    <div id="seasonName" class="num"></div>
    <div id="roundLine"></div>
    <div class="bar"><i id="progBar"></i></div>
    <div id="timer"></div>
  </div>
  <div id="wallet" class="panel">
    <div id="money" class="num">$0</div>
    <div id="debt"></div>
  </div>
  <div id="toasts"></div>
  <div id="cross"></div>
  <div id="prompt"></div>
  <div id="banner"><h1 class="num" id="bannerT"></h1><p id="bannerS"></p></div>
  <div id="stats" class="panel">
    <div class="stat" id="stHand"><div class="lab"><span id="handLab">Hands</span><b id="handTxt"></b></div><div class="bar"><i id="handBar"></i></div></div>
    <div class="stat hide" id="stSack"><div class="lab"><span>Sack</span><b id="sackTxt"></b></div><div class="bar"><i id="sackBar"></i></div></div>
    <div class="stat hide" id="stBarrow"><div class="lab"><span>Wheelbarrow</span><b id="barrowTxt"></b></div><div class="bar"><i id="barrowBar"></i></div></div>
    <div class="stat hide" id="stSeed"><div class="lab"><span>Grass seed</span><b id="seedTxt"></b></div></div>
    <div class="stat hide" id="stWater"><div class="lab"><span>Water</span><b id="waterTxt"></b></div><div class="bar"><i id="waterBar"></i></div></div>
  </div>
  <div id="hotbar"></div>
</div>

<div id="title" class="overlay show">
  <div class="card">
    <h1 class="num">Yardwork: Four Seasons</h1>
    <p>You start with bare hands and a pair of nail scissors. Carry leaves to the trailer, earn your first dollars, then buy a sack, a rake, a wheelbarrow and better gear from Gustav's hardware store. Shovel snow before the lawn rots, reseed in spring, mow in summer. Gustav will front you cash when you are broke.</p>
    <div class="keys">
      <div><b>W A S D</b> <span>move</span></div><div><b>Shift</b> <span>sprint</span></div>
      <div><b>Mouse</b> <span>look</span></div><div><b>Left click</b> <span>use tool (hold)</span></div>
      <div><b>1 – 8 / Wheel</b> <span>switch tool</span></div><div><b>E</b> <span>interact, open doors, buy, dump</span></div>
      <div><b>F</b> <span>grab / drop sack or wheelbarrow</span></div><div><b>M</b> <span>mute</span></div>
      <div><b>Esc</b> <span>pause</span></div><div><b>Gate</b> <span>leave the yard, see the street</span></div>
    </div>
    <button id="startBtn">Click to start</button>
  </div>
</div>
<div id="pause" class="overlay"><div class="card"><h2 class="num">Paused</h2><p>Click anywhere to return. The clock stops while you are paused.</p><div class="btns"><button id="resumeBtn">Resume</button></div></div></div>
<div id="modal" class="overlay"><div class="card" id="modalCard"></div></div>
<div id="fade"></div>
<div id="err" class="overlay"><div class="card"><h2 class="num">The game could not start</h2><p></p></div></div>

<script type="module">
/* =====================================================================
   YARDWORK: FOUR SEASONS  (v2)
   Single-file 3D first-person yard-work sim on Three.js (ES module, CDN).
   Physics are a lightweight custom solver (circle-vs-box collisions,
   floaty leaf dynamics), so Three.js is the only CDN dependency.
   ===================================================================== */
async function loadThree() {
  const urls = ['https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js','https://unpkg.com/three@0.160.0/build/three.module.js','https://esm.sh/three@0.160.0'];
  for (const u of urls) { try { return await import(u); } catch (e) { console.warn('CDN failed:', u, e); } }
  throw new Error('Could not load Three.js from any CDN. Check your internet connection and reload.');
}
function fatal(msg) { const e = document.getElementById('err'); e.classList.add('show'); e.querySelector('p').textContent = msg; }
let THREE;
try { THREE = await loadThree(); await main(); } catch (e) { console.error(e); fatal(e && e.message ? e.message : String(e)); }

async function main() {
/* ---------- helpers ---------- */
const $ = id => document.getElementById(id);
const rr = (a, b) => a + Math.random() * (b - a);
const rint = (a, b) => a + Math.floor(Math.random() * (b - a + 1));
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const money = v => '$' + Math.round(v).toLocaleString('en-US');
const frac = v => v - Math.floor(v);

/* ---------- world layout ---------- */
const N = 48, HALF = 24;                                   // yard = 48 x 48 one-metre cells
const cx = ix => -HALF + ix + .5, cz = iz => -HALF + iz + .5;
const RECT = { house: { x0: -12, x1: 14, z0: -24, z1: -15 }, shop: { x0: -21, x1: -14, z0: -12, z1: -5 }, trailer: { x0: 16.5, x1: 19.5, z0: 1.2, z1: 6.8 } };
const DRIVE = { x0: 8, x1: 13, z0: -15, z1: 24 };
const TRAILER_C = { x: 18, z: 4 }, TAP = { x: 0, z: -14.2 }, MARK = { x: -20, z: 12, r: 3.3 };
const TREES = [[-6,-8],[-15,6],[-5,14],[2,3],[20,-9],[21,17],[-20,20],[5,-9]];
const OBST = [RECT.trailer];                               // collision boxes {x0,x1,z0,z1,off?}
const TC = TREES.map(t => [t[0], t[1], .45]);              // tree trunk colliders
const inRect = (x, z, r, m = 0) => x > r.x0 - m && x < r.x1 + m && z > r.z0 - m && z < r.z1 + m;
const HOUSE_IN = { x0: -11.8, x1: 13.8, z0: -23.8, z1: -15.2 }, SHOP_IN = { x0: -20.7, x1: -14.3, z0: -11.7, z1: -5.3 };

/* ---------- seasons ---------- */
const SEASONS = [
  { name:'Autumn', task:'Leaf clearing',      grass:[98,112,46],  mud:[96,70,46],  skyTop:0x5f86b4, skyBot:0xf0d2a6, fog:0xd9c3a0, fd:.0095, sun:0xffd7a0, si:2.7, hemiS:0xbfcbe6, hemiG:0x6b5a40, hi:.7,  sunPos:[-34,26,24], tuft:0xe0c878, outer:0x6d6a3a, dist:0xa8622a, exp:1.0, wind:1.0, cloud:0xe8dccb, cloudA:.7 },
  { name:'Winter', task:'Snow shoveling',     grass:[96,108,80],  mud:[84,66,50],  skyTop:0x8fa4bd, skyBot:0xe2e8ef, fog:0xd7dfe8, fd:.014,  sun:0xe8f0ff, si:1.7, hemiS:0xe1eaf6, hemiG:0x8a949f, hi:.95, sunPos:[-26,17,26], tuft:0xb4bca5, outer:0xdfe6ee, dist:0xe4eaf0, exp:1.05, wind:.5,  cloud:0xdfe4ea, cloudA:.85 },
  { name:'Spring', task:'Seeding & watering', grass:[100,150,54], mud:[74,56,40],  skyTop:0x74aee6, skyBot:0xe9f2e4, fog:0xd2e2da, fd:.009,  sun:0xfff0cf, si:2.4, hemiS:0xcfe4ff, hemiG:0x5b6a45, hi:.75, sunPos:[30,30,20],  tuft:0xc4f294, outer:0x5f8a3c, dist:0x86b050, exp:1.0, wind:.8,  cloud:0xffffff, cloudA:.6 },
  { name:'Summer', task:'Lawn mowing',        grass:[58,132,42],  mud:[110,84,56], skyTop:0x3f8fe0, skyBot:0xcfe6f8, fog:0xcfe3f2, fd:.0055, sun:0xfff3dc, si:3.2, hemiS:0xd8ecff, hemiG:0x55703a, hi:.8,  sunPos:[22,44,16],  tuft:0xa6e47f, outer:0x4a7f33, dist:0x2d6a30, exp:1.0, wind:.55, cloud:0xffffff, cloudA:.55 }
];

/* ---------- items, tools, economy ---------- */
const TOOLKEY = ['hands','scissors','rake','blower','shovel','mower','seeder','can'];
const TOOLNAME = ['Hands','Nail Scissors','Rake','Leaf Blower','Snow Shovel','Lawn Mower','Seed Spreader','Watering Can'];
const SEASON_TOOLS = [[0,2,3],[0,4],[0,6,7],[1,5]];       // tools that work in each season
const SEASON_PREF = [[2,0],[4,0],[6,0],[5,1]];
const ITEMS = [
  { id:'rake',   name:'Rake',          price:60,  tool:2, desc:'Pulls leaves toward you' },
  { id:'sack',   name:'Burlap Sack',   price:50,  cont:'sack', desc:'Stores 30 units, drag it behind you' },
  { id:'can',    name:'Watering Can',  price:25,  tool:7, desc:'Waters seeded soil' },
  { id:'shovel', name:'Snow Shovel',   price:90,  tool:4, desc:'Carries twice as much snow' },
  { id:'seeder', name:'Seed Spreader', price:120, tool:6, desc:'Sows a wide strip' },
  { id:'barrow', name:'Wheelbarrow',   price:180, cont:'barrow', desc:'Stores 90 units, push it to the trailer' },
  { id:'blower', name:'Leaf Blower',   price:160, tool:3, desc:'Blows leaves across the yard' },
  { id:'mower',  name:'Lawn Mower',    price:220, tool:5, desc:'Cuts a wide swath, own grass bag' }
];
const UPG = [
  { id:'grip',   name:'Stronger Grip',      desc:'+3 units carried in your hands',           max:4, base:70,  mult:.9 },
  { id:'scissors', name:'Sharper Scissors', desc:'Wider and faster nail scissors',            max:3, base:40,  mult:.9 },
  { id:'sack',   name:'Bigger Sack',        desc:'+15 sack capacity',   need:'sack',   max:4, base:60,  mult:.9 },
  { id:'barrow', name:'Deep Wheelbarrow',   desc:'+30 wheelbarrow capacity', need:'barrow', max:4, base:120, mult:.9 },
  { id:'rake',   name:'Wide Rake',          desc:'Wider and longer sweep', need:'rake',  max:4, base:80,  mult:.8 },
  { id:'blower', name:'Turbo Blower',       desc:'More range and force', need:'blower', max:4, base:140, mult:.8 },
  { id:'shovel', name:'Pro Shovel',         desc:'Bigger blade and load', need:'shovel', max:4, base:110, mult:.8 },
  { id:'mower',  name:'Advanced Mower',     desc:'Wider deck, bigger bag', need:'mower', max:4, base:160, mult:.8 },
  { id:'seeder', name:'Automatic Spreader', desc:'Bigger area; level 3 sows as you walk', need:'seeder', max:4, base:120, mult:.9 },
  { id:'can',    name:'Big Watering Can',   desc:'More water and a wider spray', need:'can', max:4, base:90, mult:.8 }
];
const upPrice = (u, lv) => Math.round(u.base * (1 + lv * u.mult) / 10) * 10;
const LEAF_PRICE = 1.2, GRASS_UNIT_PRICE = 4.5, SEED_PRICE = 1.5, W = { leaf: .5, grass: .08, snow: 1 };

const G = {
  phase: 'title', season: 0, round: 0, rounds: 3, year: 1,
  money: 100, debt: 0, own: { hands: 1, scissors: 1 }, up: {}, tool: 0, use: false, working: false, engine: false,
  load: { type: null, n: 0 }, held: null, seeds: 0, water: 0,
  modal: null, time: 0, hint: '', hintT: 0, incAcc: 0, incT: 0, endTimer: 0, locked: false,
  snowfall: 0, tl: 0, V0: 1, V: 0, pileVol: 0, cargo: 0, grow: 1, growAcc: 0, fallAcc: 0,
  uncut: 0, cutTotal: 1, remBare: 0, bareTotal: 1, regrow: [], seedCD: 0, scoopT: 0, grabAcc: 0, scisT: 0,
  gateOpen: false, indoor: 0, speech: '', shelfHover: null, grabCand: null
};
const lvl = id => G.up[id] || 0;
const owns = t => !!G.own[TOOLKEY[t]];
function stats() {
  return {
    handCap: 6 + 3 * lvl('grip'), sackCap: 30 + 15 * lvl('sack'), barrowCap: 90 + 30 * lvl('barrow'),
    scisR: .5 + .12 * lvl('scissors'), scisCD: .7 / (1 + .3 * lvl('scissors')),
    rakeR: 2.2 + .5 * lvl('rake'), rakeA: .9 + .08 * lvl('rake'),
    blowR: 5 + 1.5 * lvl('blower'), blowF: 1 + .3 * lvl('blower'),
    shovCap: 12 + 4 * lvl('shovel'), shovR: .9 + .25 * lvl('shovel'), shovRate: 2.6 + .7 * lvl('shovel'),
    mowR: 1 + .25 * lvl('mower'), mowCap: 30 + 10 * lvl('mower'),
    seedR: .9 + .35 * lvl('seeder'), seedCD: .35 / (1 + .35 * lvl('seeder')), seedAuto: lvl('seeder') >= 3,
    canCap: 40 + 20 * lvl('can'), canR: 1 + .3 * lvl('can')
  };
}

/* ---------- renderer / scene ---------- */
const canvas = $('c');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
renderer.shadowMap.enabled = true; renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping; renderer.outputColorSpace = THREE.SRGBColorSpace;
const ANISO = Math.min(8, renderer.capabilities.getMaxAnisotropy());
const scene = new THREE.Scene(); scene.fog = new THREE.FogExp2(0xcccccc, .01);
const camera = new THREE.PerspectiveCamera(72, innerWidth / innerHeight, .05, 900); camera.rotation.order = 'YXZ'; scene.add(camera);
function resize() { renderer.setSize(innerWidth, innerHeight, false); camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix(); }
addEventListener('resize', resize); resize();

const hemi = new THREE.HemisphereLight(0xffffff, 0x555544, .7); scene.add(hemi);
const sun = new THREE.DirectionalLight(0xffffff, 2.5); sun.castShadow = true;
const bigShadow = renderer.capabilities.maxTextureSize >= 8192; sun.shadow.mapSize.set(bigShadow ? 4096 : 2048, bigShadow ? 4096 : 2048);
Object.assign(sun.shadow.camera, { left: -34, right: 34, top: 34, bottom: -34, near: 1, far: 170 });
sun.shadow.bias = -.0003; sun.shadow.normalBias = .035; scene.add(sun, sun.target);

// Sky dome with sun disc + glow
const skyMat = new THREE.ShaderMaterial({
  side: THREE.BackSide, depthWrite: false, fog: false,
  uniforms: { top: { value: new THREE.Color() }, bot: { value: new THREE.Color() }, sunDir: { value: new THREE.Vector3(0, 1, 0) } },
  vertexShader: 'varying vec3 vP;void main(){vP=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}',
  fragmentShader: 'uniform vec3 top;uniform vec3 bot;uniform vec3 sunDir;varying vec3 vP;void main(){vec3 d=normalize(vP);float t=clamp(d.y*1.4+.08,0.,1.);vec3 c=mix(bot,top,pow(t,.7));float sd=max(dot(d,normalize(sunDir)),0.);c+=vec3(1.,.93,.78)*(pow(sd,900.)*3.+pow(sd,14.)*.22);gl_FragColor=vec4(c,1.);\n#include <colorspace_fragment>\n}'
});
const sky = new THREE.Mesh(new THREE.SphereGeometry(700, 24, 12), skyMat); sky.renderOrder = -2; scene.add(sky);

/* ---------- textures & materials ---------- */
function canvasTex(w, h, draw, rep) {
  const c = document.createElement('canvas'); c.width = w; c.height = h; draw(c.getContext('2d'), w, h);
  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace; t.wrapS = t.wrapT = THREE.RepeatWrapping;
  if (rep) t.repeat.set(rep[0], rep[1]); t.anisotropy = ANISO; return t;
}
function speckle(g, w, h, base, amp, n) {
  g.fillStyle = base; g.fillRect(0, 0, w, h);
  for (let i = 0; i < n; i++) { const v = (Math.random() - .5) * amp; g.fillStyle = v > 0 ? `rgba(255,255,255,${v / 255})` : `rgba(0,0,0,${-v / 255})`; g.fillRect(Math.random() * w, Math.random() * h, 2, 2); }
}
const std = o => new THREE.MeshStandardMaterial(o);
const mat = (c, r = .6, m = 0) => std({ color: c, roughness: r, metalness: m });
const TEX = {
  wood: canvasTex(128, 128, (g, w, h) => { speckle(g, w, h, '#8a6a46', 60, 900); for (let x = 0; x < w; x += 16) { g.fillStyle = 'rgba(0,0,0,.28)'; g.fillRect(x, 0, 1, h); } }),
  siding: canvasTex(128, 128, (g, w, h) => { speckle(g, w, h, '#d9d3c4', 24, 500); for (let y = 0; y < h; y += 16) { g.fillStyle = 'rgba(0,0,0,.2)'; g.fillRect(0, y, w, 2); g.fillStyle = 'rgba(255,255,255,.18)'; g.fillRect(0, y + 2, w, 1); } }, [6, 2]),
  roof: canvasTex(128, 128, (g, w, h) => { speckle(g, w, h, '#4a3f3a', 40, 700); for (let y = 0; y < h; y += 12) { g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(0, y, w, 2); } for (let y = 0; y < h; y += 24) for (let x = 0; x < w; x += 16) { g.fillStyle = 'rgba(0,0,0,.22)'; g.fillRect(x + (y % 48 ? 8 : 0), y, 1, 12); } }, [8, 1]),
  bark: canvasTex(64, 128, (g, w, h) => { speckle(g, w, h, '#5b4330', 70, 700); for (let x = 0; x < w; x += 7) { g.fillStyle = 'rgba(0,0,0,.3)'; g.fillRect(x, 0, 2, h); } }, [1, 2]),
  floor: canvasTex(256, 256, (g, w, h) => { speckle(g, w, h, '#a57f56', 40, 1400); for (let y = 0; y < h; y += 32) { g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(0, y, w, 2); for (let x = (y / 32 % 2) * 64; x < w; x += 128) g.fillRect(x, y, 2, 32); } }, [6, 3]),
  asphalt: canvasTex(256, 256, (g, w, h) => speckle(g, w, h, '#3a3d41', 70, 5000), [40, 2]),
  concrete: canvasTex(256, 256, (g, w, h) => { speckle(g, w, h, '#a9a9a4', 40, 2500); g.fillStyle = 'rgba(0,0,0,.25)'; g.fillRect(0, 0, 2, h); g.fillRect(0, 0, w, 2); }, [32, 1]),
  noise: canvasTex(128, 128, (g, w, h) => speckle(g, w, h, '#808080', 120, 4000), [16, 16])
};
const M = {
  wood: std({ map: TEX.wood, bumpMap: TEX.wood, bumpScale: 1.2, roughness: .85 }),
  siding: std({ map: TEX.siding, bumpMap: TEX.siding, bumpScale: 1.4, roughness: .9 }),
  roof: std({ map: TEX.roof, bumpMap: TEX.roof, bumpScale: 1.6, roughness: .9 }),
  bark: std({ map: TEX.bark, bumpMap: TEX.bark, bumpScale: 2, roughness: .95 }),
  floor: std({ map: TEX.floor, roughness: .55 }),
  plaster: std({ color: 0xe9e4d8, roughness: .95 }),
  snow: std({ color: 0xf3f7ff, roughness: .85 }), metal: mat(0x6f7881, .45, .6), white: mat(0xe9e9e4, .7), dark: mat(0x23272b, .8),
  glass: std({ color: 0x9fc4e0, roughness: .05, metalness: .3, transparent: true, opacity: .3 }),
  emis: std({ color: 0xfff1cf, emissive: 0xffe2a8, emissiveIntensity: 1.6 })
};
function box(w, hh, d, m, x, y, z, parent = scene, cast = true) {
  const o = new THREE.Mesh(new THREE.BoxGeometry(w, hh, d), m); o.position.set(x, y, z);
  o.castShadow = cast; o.receiveShadow = true; parent.add(o); return o;
}

/* ---------- clouds ---------- */
const cloudTex = canvasTex(256, 128, (g, w, hh) => {
  for (let i = 0; i < 46; i++) { const x = rr(40, 216), y = rr(35, 95), r = rr(18, 40), gr = g.createRadialGradient(x, y, 0, x, y, r); gr.addColorStop(0, 'rgba(255,255,255,.34)'); gr.addColorStop(1, 'rgba(255,255,255,0)'); g.fillStyle = gr; g.beginPath(); g.arc(x, y, r, 0, 7); g.fill(); }
}); cloudTex.wrapS = cloudTex.wrapT = THREE.ClampToEdgeWrapping;
const clouds = [];
for (let i = 0; i < 16; i++) {
  const m = new THREE.Mesh(new THREE.PlaneGeometry(rr(140, 240), rr(70, 120)), new THREE.MeshBasicMaterial({ map: cloudTex, transparent: true, depthWrite: false, fog: false, opacity: .6 }));
  m.rotation.x = -Math.PI / 2; m.position.set(rr(-380, 380), rr(130, 190), rr(-380, 380)); m.renderOrder = -1; scene.add(m); clouds.push(m);
}

/* ---------- cell grid ---------- */
const type = new Uint8Array(N * N);                       // 0 blocked, 1 grass, 2 paved
const bare = new Uint8Array(N * N), seeded = new Uint8Array(N * N), watered = new Uint8Array(N * N);
const snow = new Float32Array(N * N), snowT = new Float32Array(N * N), hgt = new Float32Array(N * N);
const ao = new Float32Array(N * N), rnd = new Float32Array(N * N);
for (let iz = 0; iz < N; iz++) for (let ix = 0; ix < N; ix++) {
  const i = iz * N + ix, x = cx(ix), z = cz(iz); rnd[i] = Math.random();
  let t = 1;
  if (inRect(x, z, RECT.house, .4) || inRect(x, z, RECT.shop, .5) || inRect(x, z, RECT.trailer, .4)) t = 0;
  else if (x > DRIVE.x0 && x < DRIVE.x1 && z > DRIVE.z0 && z < DRIVE.z1) t = 2;
  type[i] = t; hgt[i] = .3;
}
for (let iz = 0; iz < N; iz++) for (let ix = 0; ix < N; ix++) {               // baked ambient occlusion
  let best = 9;
  for (let dz = -3; dz <= 3; dz++) for (let dx = -3; dx <= 3; dx++) { const a = ix + dx, b = iz + dz; if (a < 0 || b < 0 || a >= N || b >= N) continue; if (type[b * N + a] === 0) best = Math.min(best, Math.hypot(dx, dz)); }
  ao[iz * N + ix] = 1 - .4 * clamp(1 - (best - .5) / 2.5, 0, 1);
}
function forCircle(px, pz, r, fn) {
  const x0 = Math.max(0, Math.floor(px + HALF - r)), x1 = Math.min(N - 1, Math.floor(px + HALF + r));
  const z0 = Math.max(0, Math.floor(pz + HALF - r)), z1 = Math.min(N - 1, Math.floor(pz + HALF + r));
  outer: for (let iz = z0; iz <= z1; iz++) for (let ix = x0; ix <= x1; ix++) {
    const dx = cx(ix) - px, dz = cz(iz) - pz; if (dx * dx + dz * dz <= r * r) { if (fn(iz * N + ix, dx, dz) === false) break outer; }
  }
}
const cellAt = (x, z) => { const ix = Math.floor(x + HALF), iz = Math.floor(z + HALF); return (ix < 0 || iz < 0 || ix >= N || iz >= N) ? -1 : iz * N + ix; };

/* ---------- ground (canvas texture + snow-displaced mesh) ---------- */
const gcan = document.createElement('canvas'); gcan.width = gcan.height = N * 8; const gctx = gcan.getContext('2d');
const gtex = new THREE.CanvasTexture(gcan); gtex.colorSpace = THREE.SRGBColorSpace; gtex.anisotropy = ANISO;
const bumpT = TEX.noise; bumpT.repeat.set(24, 24);
const gGeo = new THREE.PlaneGeometry(N, N, N, N); gGeo.rotateX(-Math.PI / 2);
const ground = new THREE.Mesh(gGeo, std({ map: gtex, bumpMap: bumpT, bumpScale: 1.1, roughness: .97 })); ground.receiveShadow = true; scene.add(ground);
const outerG = new THREE.Mesh(new THREE.PlaneGeometry(1400, 1400).rotateX(-Math.PI / 2), std({ color: 0x4a7f33, roughness: 1 })); outerG.position.y = -.04; outerG.receiveShadow = true; scene.add(outerG);

const dirty = new Set(); let snowDirty = false;
const mark = i => dirty.add(i);
const markAll = () => { for (let i = 0; i < N * N; i++) dirty.add(i); snowDirty = true; };
function drawCell(i) {
  const ix = i % N, iz = (i / N) | 0, S = SEASONS[G.season], t = type[i], r = rnd[i]; let c;
  if (t === 0) c = [64, 60, 56];
  else if (t === 2) { const v = 112 + r * 22; c = [v, v, v - 3]; }
  else if (bare[i]) { const b = watered[i] ? [48, 35, 26] : seeded[i] ? [86, 62, 42] : S.mud; c = [b[0] + r * 12, b[1] + r * 9, b[2] + r * 7]; }
  else { const g = S.grass, cut = (G.season === 3 && hgt[i] < .3) ? (iz % 2 ? 10 : -8) : 0, v = (r - .5) * 20 + cut; c = [g[0] + v * .6, g[1] + v, g[2] + v * .4]; }
  const a = ao[i]; c = [c[0] * a, c[1] * a, c[2] * a];
  const s = snow[i];
  if (s > .01 && t !== 0) { const k = Math.min(1, s * 1.5 + .15); c = [c[0] + (236 - c[0]) * k, c[1] + (240 - c[1]) * k, c[2] + (248 - c[2]) * k]; }
  const X = ix * 8, Y = iz * 8;
  gctx.fillStyle = `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`; gctx.fillRect(X, Y, 8, 8);
  for (let k = 0; k < 5; k++) {
    const hh = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453, gx = (frac(hh) * 7) | 0, gy = (frac(hh * 7.1) * 7) | 0, d = (frac(hh * 3.3) - .5) * 40;
    gctx.fillStyle = `rgb(${clamp(c[0] + d, 0, 255) | 0},${clamp(c[1] + d, 0, 255) | 0},${clamp(c[2] + d, 0, 255) | 0})`; gctx.fillRect(X + gx, Y + gy, 2, 1);
  }
}
function updateSnowMesh() {
  const pos = gGeo.attributes.position;
  for (let j = 0; j <= N; j++) for (let i = 0; i <= N; i++) {
    let s = 0, c = 0;
    for (let dj = -1; dj <= 0; dj++) for (let di = -1; di <= 0; di++) { const ix = i + di, iz = j + dj; if (ix < 0 || iz < 0 || ix >= N || iz >= N) continue; s += snow[iz * N + ix]; c++; }
    pos.setY(j * (N + 1) + i, c ? s / c * .3 : 0);
  }
  pos.needsUpdate = true; gGeo.computeVertexNormals();
}

/* ---------- dense wind-swayed grass tufts (instanced, vertex shader wind) ---------- */
const TPC = 12, TMAX = N * N * TPC;
function bladeGeo() {
  const pos = [], col = [], nor = [], w = .06;
  for (let b = 0; b < 4; b++) {
    const a = b * Math.PI / 4, c = Math.cos(a), s = Math.sin(a);
    pos.push(-w * c, 0, -w * s, w * c, 0, w * s, .04 * c, 1, .04 * s);
    col.push(.2, .33, .1, .2, .33, .1, .74, .94, .42); nor.push(0, 1, 0, 0, 1, 0, 0, 1, 0);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3)); g.setAttribute('color', new THREE.Float32BufferAttribute(col, 3)); g.setAttribute('normal', new THREE.Float32BufferAttribute(nor, 3)); return g;
}
const windU = { value: 0 }, windS = { value: 1 };
const tMat = std({ vertexColors: true, side: THREE.DoubleSide, roughness: .9, color: 0xffffff });
tMat.onBeforeCompile = sh => {
  sh.uniforms.uTime = windU; sh.uniforms.uWind = windS;
  sh.vertexShader = sh.vertexShader.replace('#include <common>', '#include <common>\nuniform float uTime;uniform float uWind;')
    .replace('#include <project_vertex>', `
    vec4 wp = vec4(transformed, 1.0);
    #ifdef USE_INSTANCING
      float sy = instanceMatrix[1].y; wp = instanceMatrix * wp;
    #else
      float sy = 1.0;
    #endif
    float bh = position.y; float ph = wp.x*.35 + wp.z*.27;
    float sw = sin(uTime*1.7+ph)*.6 + sin(uTime*3.3+ph*2.1)*.25 + sin(uTime*.45+wp.x*.05)*.9;
    wp.x += sw*uWind*sy*bh*bh*.55; wp.z += sw*uWind*sy*bh*bh*.2;
    vec4 mvPosition = modelViewMatrix * wp; gl_Position = projectionMatrix * mvPosition;`);
};
const tufts = new THREE.InstancedMesh(bladeGeo(), tMat, TMAX); tufts.frustumCulled = false; tufts.receiveShadow = true;
const tOff = new Float32Array(TMAX * 4), tmpC = new THREE.Color();
for (let i = 0; i < N * N; i++) for (let k = 0; k < TPC; k++) {
  const o = (i * TPC + k) * 4; tOff[o] = rr(-.5, .5); tOff[o + 1] = rr(-.5, .5); tOff[o + 2] = rr(0, 6.28); tOff[o + 3] = rr(.8, 1.4);
  const v = rr(.78, 1.05); tmpC.setRGB(v, v, v * rr(.88, 1)); tufts.setColorAt(i * TPC + k, tmpC);
}
scene.add(tufts);
const dummy = new THREE.Object3D();
function updateTufts(i) {
  const ix = i % N, iz = (i / N) | 0, x0 = cx(ix), z0 = cz(iz), show = type[i] === 1 && !bare[i] && snow[i] < .22;
  let hh = 0; if (show) { const hv = hgt[i]; hh = .07 + .5 * (hv > .5 ? (.3 + .7 * G.grow) : hv); }
  for (let k = 0; k < TPC; k++) {
    const o = (i * TPC + k) * 4;
    dummy.position.set(x0 + tOff[o], snow[i] * .3, z0 + tOff[o + 1]); dummy.rotation.set(0, tOff[o + 2], 0);
    if (hh > 0) dummy.scale.set(tOff[o + 3], hh * tOff[o + 3], tOff[o + 3]); else dummy.scale.set(0, 0, 0);
    dummy.updateMatrix(); tufts.setMatrixAt(i * TPC + k, dummy.matrix);
  }
}
function refreshAllTufts() { for (let i = 0; i < N * N; i++) updateTufts(i); tufts.instanceMatrix.needsUpdate = true; }
function flush() { if (dirty.size) { for (const i of dirty) { drawCell(i); updateTufts(i); } dirty.clear(); gtex.needsUpdate = true; tufts.instanceMatrix.needsUpdate = true; } }

/* ---------- walls, doors, building helpers ---------- */
const snowShells = [];                                        // roof snow caps (winter only)
const DOORS = [];
function sidedMat(ext, extMat) { const a = [M.plaster, M.plaster, M.plaster, M.plaster, M.plaster, M.plaster]; a[{ px: 0, nx: 1, pz: 4, nz: 5 }[ext]] = extMat; return a; }
function wallBox(x0, z0, x1, z1, y0, y1, ext, extMat, parent, col = true) {
  const m = new THREE.Mesh(new THREE.BoxGeometry(x1 - x0, y1 - y0, z1 - z0), sidedMat(ext, extMat));
  m.position.set((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2); m.castShadow = true; m.receiveShadow = true; parent.add(m);
  if (col && y0 < 1) OBST.push({ x0, x1, z0, z1 }); return m;
}
// a wall running along X at depth zc, with window / door openings
function xWall(zc, x0, x1, thick, H, ops, ext, extMat, parent) {
  let cur = x0; const z0 = zc - thick / 2, z1 = zc + thick / 2; ops = ops.slice().sort((a, b) => a.x0 - b.x0);
  for (const o of ops) {
    if (o.x0 > cur) wallBox(cur, z0, o.x0, z1, 0, H, ext, extMat, parent);
    if (o.y0 > 0) wallBox(o.x0, z0, o.x1, z1, 0, o.y0, ext, extMat, parent);
    wallBox(o.x0, z0, o.x1, z1, o.y1, H, ext, extMat, parent, false);
    if (!o.door) {
      const gl = new THREE.Mesh(new THREE.PlaneGeometry(o.x1 - o.x0, o.y1 - o.y0), M.glass); gl.position.set((o.x0 + o.x1) / 2, (o.y0 + o.y1) / 2, zc); parent.add(gl);
      const fw = .07, mw = (o.x0 + o.x1) / 2, mh = (o.y0 + o.y1) / 2, ww = o.x1 - o.x0, wh = o.y1 - o.y0;
      for (const [w, hh, x, y] of [[ww + .1, fw, mw, o.y0], [ww + .1, fw, mw, o.y1], [fw, wh, o.x0, mh], [fw, wh, o.x1, mh], [fw, wh, mw, mh], [ww, fw, mw, mh]]) box(w, hh, thick + .08, M.white, x, y, zc, parent, false);
    }
    cur = o.x1;
  }
  if (cur < x1) wallBox(cur, z0, x1, z1, 0, H, ext, extMat, parent);
}
function makeDoor(hx, hz, w, hh, sign, mat_, parent, rect, label, ix, iz) {
  const pivot = new THREE.Group(); pivot.position.set(hx, 0, hz); parent.add(pivot);
  box(w, hh, .07, mat_, sign * w / 2, hh / 2, 0, pivot);
  const knob = new THREE.Mesh(new THREE.SphereGeometry(.04, 8, 6), mat(0xc8a64a, .3, .8)); knob.position.set(sign * (w - .12), hh * .45, .06); pivot.add(knob);
  const d = { pivots: [{ g: pivot, s: sign }], a: 0, t: 0, rect, label, x: ix, z: iz }; DOORS.push(d); if (rect) OBST.push(rect); return d;
}

/* ---------- procedural models (used in hand, on shelves, in the world) ---------- */
const rod = (len, r, m) => { const o = new THREE.Mesh(new THREE.CylinderGeometry(r, r, len, 8), m); o.rotation.x = Math.PI / 2; o.castShadow = true; return o; };
const WD = mat(0xa57c4a, .8), MT = mat(0x8a9097, .4, .7), ORG = mat(0xe8740c, .5), RED = mat(0xc4262e, .5), BLU = mat(0x2d6ecf, .5), DK = mat(0x23272b, .8), GRN = mat(0x3f8f4a, .5, .4);
const MODELS = {
  rake() { const g = new THREE.Group(); let o = rod(1.9, .018, WD); o.position.z = -.25; g.add(o); o = new THREE.Mesh(new THREE.BoxGeometry(.62, .025, .05), MT); o.position.z = -1.2; g.add(o);
    for (let i = 0; i < 9; i++) { const t = new THREE.Mesh(new THREE.BoxGeometry(.012, .012, .22), MT); t.position.set(-.28 + i * .07, -.012, -1.31); g.add(t); } return g; },
  blower() { const g = new THREE.Group(); let o = new THREE.Mesh(new THREE.BoxGeometry(.24, .22, .5), ORG); g.add(o); o = rod(.75, .055, DK); o.position.set(0, -.02, -.6); g.add(o);
    o = new THREE.Mesh(new THREE.TorusGeometry(.07, .015, 6, 12), DK); o.position.set(0, .16, .05); g.add(o); return g; },
  shovel() { const g = new THREE.Group(); let o = rod(1.7, .02, WD); o.position.z = -.2; g.add(o);
    o = new THREE.Mesh(new THREE.BoxGeometry(.3, .02, .36), BLU); o.position.set(0, -.03, -1.2); o.rotation.x = -.25; g.add(o);
    o = new THREE.Mesh(new THREE.TorusGeometry(.06, .012, 6, 10), DK); o.position.set(0, .04, .62); g.add(o); return g; },
  mower() { const g = new THREE.Group(); let o = new THREE.Mesh(new THREE.BoxGeometry(.85, .3, 1.05), RED); o.position.y = .35; o.castShadow = true; g.add(o);
    o = new THREE.Mesh(new THREE.BoxGeometry(.95, .08, 1.15), DK); o.position.y = .17; g.add(o);
    for (const [sx, sz] of [[-.45, -.4], [.45, -.4], [-.45, .4], [.45, .4]]) { const wh = new THREE.Mesh(new THREE.CylinderGeometry(.13, .13, .07, 14), DK); wh.rotation.z = Math.PI / 2; wh.position.set(sx, .13, sz); g.add(wh); }
    for (const sx of [-.3, .3]) { const hb = rod(1, .018, MT); hb.rotation.x = .9; hb.position.set(sx, .85, .85); g.add(hb); }
    o = new THREE.Mesh(new THREE.BoxGeometry(.7, .06, .06), DK); o.position.set(0, 1.3, 1.25); g.add(o);
    o = new THREE.Mesh(new THREE.BoxGeometry(.6, .4, .4), mat(0x3a3f44, .9)); o.position.set(0, .6, .55); g.add(o); return g; },
  seeder() { const g = new THREE.Group(); let o = new THREE.Mesh(new THREE.CylinderGeometry(.2, .12, .26, 12), M.white); o.position.y = .5; g.add(o);
    o = new THREE.Mesh(new THREE.CylinderGeometry(.2, .2, .05, 16), DK); o.rotation.z = Math.PI / 2; o.position.y = .2; g.add(o);
    for (const sx of [-.15, .15]) { const hb = rod(.9, .016, MT); hb.rotation.x = .8; hb.position.set(sx, .75, .4); g.add(hb); } return g; },
  can() { const g = new THREE.Group(); let o = new THREE.Mesh(new THREE.CylinderGeometry(.13, .13, .26, 14), GRN); g.add(o);
    o = rod(.4, .02, GRN); o.rotation.x = Math.PI / 2 - .8; o.position.set(0, .05, -.25); g.add(o);
    o = new THREE.Mesh(new THREE.TorusGeometry(.1, .014, 6, 12), GRN); o.position.set(.14, .02, 0); o.rotation.y = Math.PI / 2; g.add(o); return g; },
  scissors() { const g = new THREE.Group(); for (const s of [-1, 1]) { const b = new THREE.Mesh(new THREE.BoxGeometry(.012, .01, .22), MT); b.position.set(s * .01, 0, -.12); b.rotation.y = s * .08; g.add(b); const r = new THREE.Mesh(new THREE.TorusGeometry(.035, .008, 6, 10), mat(0xd23a3a, .5)); r.position.set(s * .035, 0, .06); r.rotation.x = Math.PI / 2; g.add(r); } return g; },
  hands() { const g = new THREE.Group(), skin = mat(0xd9a77f, .7), sl = mat(0x3d6b8f, .8);
    for (const s of [-1, 1]) { const arm = new THREE.Mesh(new THREE.CapsuleGeometry(.045, .4, 4, 8), skin); arm.rotation.x = 1.35; arm.position.set(s * .24, 0, 0); g.add(arm);
      const c = new THREE.Mesh(new THREE.CylinderGeometry(.062, .068, .24, 10), sl); c.rotation.x = 1.35; c.position.set(s * .24, -.07, .17); g.add(c); }
    const blob = new THREE.Mesh(new THREE.SphereGeometry(.14, 10, 8), mat(0xb4682a, 1)); blob.position.set(0, .06, -.2); g.add(blob); g.userData.blob = blob; return g; },
  sack() { const g = new THREE.Group(), m = std({ color: 0xb89a62, roughness: 1, bumpMap: TEX.wood, bumpScale: 1 });
    const b = new THREE.Mesh(new THREE.SphereGeometry(.38, 14, 10), m); b.scale.set(1, 1.25, .8); b.position.y = .45; b.castShadow = true; g.add(b);
    const n = new THREE.Mesh(new THREE.CylinderGeometry(.1, .18, .18, 10), m); n.position.y = .95; g.add(n);
    const t = new THREE.Mesh(new THREE.TorusGeometry(.12, .02, 6, 12), mat(0x6b4b2a, .9)); t.rotation.x = Math.PI / 2; t.position.y = .9; g.add(t); g.userData.body = b; return g; },
  barrow() { const g = new THREE.Group(), m = mat(0x2f6fa8, .5, .3);
    let o = new THREE.Mesh(new THREE.BoxGeometry(.7, .32, .95), m); o.position.set(0, .62, .1); o.castShadow = true; g.add(o);
    o = new THREE.Mesh(new THREE.BoxGeometry(.5, .06, .7), m); o.position.set(0, .45, -.45); g.add(o);
