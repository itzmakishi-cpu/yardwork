/* ---------- first-person tools ---------- */
const rod = (len, r, m) => { const o = new THREE.Mesh(new THREE.CylinderGeometry(r, r, len, 8), m); o.rotation.x = Math.PI / 2; o.castShadow = true; return o; };
const tools = [];
{
  const wood = mat(0xa57c4a, .8), metal = mat(0x8a9097, .4, .7), orange = mat(0xe8740c, .5), red = mat(0xc4262e, .5), blue = mat(0x2d6ecf, .5), dark = mat(0x23272b, .8);
  // 0 rake
  let g = new THREE.Group(); let o = rod(1.9, .018, wood); o.position.z = -.25; g.add(o);
  o = new THREE.Mesh(new THREE.BoxGeometry(.62, .025, .05), metal); o.position.z = -1.2; g.add(o);
  for (let i = 0; i < 9; i++) { const t = new THREE.Mesh(new THREE.BoxGeometry(.012, .012, .22), metal); t.position.set(-.28 + i * .07, -.012, -1.31); g.add(t); }
  g.userData.base = [.36, -.42, -.6, -.5, -.15, 0]; tools.push(g);
  // 1 blower
  g = new THREE.Group(); o = new THREE.Mesh(new THREE.BoxGeometry(.24, .22, .5), orange); g.add(o);
  o = rod(.75, .055, dark); o.position.set(0, -.02, -.6); g.add(o);
  o = new THREE.Mesh(new THREE.TorusGeometry(.07, .015, 6, 12), dark); o.position.set(0, .16, .05); g.add(o);
  g.userData.base = [.3, -.3, -.55, -.1, .05, 0]; tools.push(g);
  // 2 shovel
  g = new THREE.Group(); o = rod(1.7, .02, wood); o.position.z = -.2; g.add(o);
  o = new THREE.Mesh(new THREE.BoxGeometry(.3, .02, .36), blue); o.position.set(0, -.03, -1.2); o.rotation.x = -.25; o.castShadow = true; g.add(o);
  g.userData.base = [.34, -.4, -.55, -.55, -.12, 0]; tools.push(g);
  // 3 mower
  g = new THREE.Group(); o = new THREE.Mesh(new THREE.BoxGeometry(.85, .3, 1.05), red); o.position.y = .35; o.castShadow = true; g.add(o);
  o = new THREE.Mesh(new THREE.BoxGeometry(.95, .08, 1.15), dark); o.position.y = .17; g.add(o);
  for (const [sx, sz] of [[-.45, -.4], [.45, -.4], [-.45, .4], [.45, .4]]) { const wh = new THREE.Mesh(new THREE.CylinderGeometry(.13, .13, .07, 14), dark); wh.rotation.z = Math.PI / 2; wh.position.set(sx, .13, sz); g.add(wh); }
  for (const sx of [-.3, .3]) { const hb = rod(1, .018, metal); hb.rotation.x = .9; hb.position.set(sx, .85, .85); g.add(hb); }
  o = new THREE.Mesh(new THREE.BoxGeometry(.7, .06, .06), dark); o.position.set(0, 1.3, 1.25); g.add(o);
  o = new THREE.Mesh(new THREE.BoxGeometry(.6, .4, .4), mat(0x3a3f44, .9)); o.position.set(0, .6, .55); g.add(o);
  g.userData.base = [0, -1.66, -1.75, 0, 0, 0]; tools.push(g);
  // 4 seed spreader
  g = new THREE.Group(); o = new THREE.Mesh(new THREE.CylinderGeometry(.2, .12, .26, 12), mat(0xe9e9e4, .6)); o.position.y = .5; g.add(o);
  o = new THREE.Mesh(new THREE.CylinderGeometry(.2, .2, .05, 16), dark); o.rotation.z = Math.PI / 2; o.position.set(0, .2, 0); g.add(o);
  for (const sx of [-.15, .15]) { const hb = rod(.9, .016, metal); hb.rotation.x = .8; hb.position.set(sx, .75, .4); g.add(hb); }
  g.userData.base = [.2, -1.1, -1.2, 0, 0, 0]; tools.push(g);
  // 5 watering can
  g = new THREE.Group(); o = new THREE.Mesh(new THREE.CylinderGeometry(.13, .13, .26, 14), mat(0x3f8f4a, .5, .4)); g.add(o);
  o = rod(.4, .02, mat(0x3f8f4a, .5, .4)); o.rotation.x = Math.PI / 2 - .8; o.position.set(0, .05, -.25); g.add(o);
  o = new THREE.Mesh(new THREE.TorusGeometry(.1, .014, 6, 12), mat(0x3f8f4a, .5, .4)); o.position.set(.14, .02, 0); o.rotation.y = Math.PI / 2; g.add(o);
  g.userData.base = [.32, -.34, -.62, 0, .15, 0]; tools.push(g);
  tools.forEach(t => { t.visible = false; camera.add(t); });
}

/* ---------- audio (procedural Web Audio) ---------- */
const AU = { ctx: null, mute: false };
function initAudio() {
  if (AU.ctx) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)(); AU.ctx = ctx;
    AU.master = ctx.createGain(); AU.master.gain.value = .6; AU.master.connect(ctx.destination);
    const len = ctx.sampleRate * 2, buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0);
    for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1; AU.noise = buf;
    const loop = (t, f, q) => { const s = ctx.createBufferSource(); s.buffer = buf; s.loop = true; const fl = ctx.createBiquadFilter(); fl.type = t; fl.frequency.value = f; fl.Q.value = q; const g = ctx.createGain(); g.gain.value = 0; s.connect(fl); fl.connect(g); g.connect(AU.master); s.start(); return { fl, g }; };
    AU.blow = loop('bandpass', 650, .8); AU.rake = loop('highpass', 3200, .7); AU.mow = loop('lowpass', 520, 1); AU.water = loop('highpass', 2800, .5);
    AU.osc = ctx.createOscillator(); AU.osc.type = 'sawtooth'; AU.osc.frequency.value = 58;
    const of = ctx.createBiquadFilter(); of.type = 'lowpass'; of.frequency.value = 380; AU.og = ctx.createGain(); AU.og.gain.value = 0;
    AU.osc.connect(of); of.connect(AU.og); AU.og.connect(AU.master); AU.osc.start();
  } catch (e) { console.warn('Audio unavailable', e); AU.ctx = null; }
}
const setLoop = (l, v) => { if (AU.ctx && l) l.g.gain.setTargetAtTime(AU.mute ? 0 : v, AU.ctx.currentTime, .06); };
function burst(f, dur, vol, type = 'bandpass') {
  if (!AU.ctx || AU.mute) return; const c = AU.ctx, s = c.createBufferSource(); s.buffer = AU.noise;
  const fl = c.createBiquadFilter(); fl.type = type; fl.frequency.value = f; const g = c.createGain(); const t = c.currentTime;
  g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + dur); s.connect(fl); fl.connect(g); g.connect(AU.master); s.start(t, Math.random()); s.stop(t + dur);
}
function tone(f, dur, vol, delay = 0, type = 'triangle') {
  if (!AU.ctx || AU.mute) return; const c = AU.ctx, o = c.createOscillator(), g = c.createGain(), t = c.currentTime + delay;
  o.type = type; o.frequency.value = f; g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + dur); o.connect(g); g.connect(AU.master); o.start(t); o.stop(t + dur);
}
const coin = () => { tone(880, .18, .18); tone(1320, .3, .16, .08); };

/* ---------- HUD helpers ---------- */
const hotbar = $('hotbar');
TOOLS.forEach((n, i) => { const d = document.createElement('div'); d.className = 'slot'; d.innerHTML = `<div class="k num">${i + 1}</div><div class="n num">${n}</div>`; hotbar.appendChild(d); });
const slots = [...hotbar.children];
function toast(msg, kind = '') { const d = document.createElement('div'); d.className = 'toast ' + kind; d.textContent = msg; $('toasts').appendChild(d); setTimeout(() => d.remove(), 3700); }
function banner(t, s) { const b = $('banner'); $('bannerT').textContent = t; $('bannerS').textContent = s; b.classList.remove('show'); void b.offsetWidth; b.classList.add('show'); }
function fadeTo(cb) { const f = $('fade'); f.classList.add('on'); setTimeout(() => { cb(); setTimeout(() => f.classList.remove('on'), 200); }, 650); }
function hint(msg) { G.hint = msg; G.hintT = 2; }
function income(amount) {
  if (G.debt > 0) { const rep = Math.min(G.debt, amount * .5); G.debt -= rep; amount -= rep; G.incRep = (G.incRep || 0) + rep; }
  G.money += amount; G.incAcc += amount; G.incT = 1.1;
}
const bagUnits = () => G.bag.n * (G.bag.type ? W[G.bag.type] : 0);
const bagCanAdd = t => (G.bag.type === null || G.bag.type === t || G.bag.n === 0) && bagUnits() + W[t] <= stats().bagCap + 1e-6;
function addBag(t) { if (G.bag.n === 0) G.bag.type = t; G.bag.n++; }
const countBare = () => { let c = 0; for (let i = 0; i < N * N; i++) if (type[i] === 1 && bare[i]) c++; return c; };

/* ---------- season visuals ---------- */
function applySeasonVisuals() {
  const S = SEASONS[G.season];
  skyMat.uniforms.top.value.setHex(S.skyTop); skyMat.uniforms.bot.value.setHex(S.skyBot);
  scene.fog.color.setHex(S.fog); scene.fog.density = S.fd;
  hemi.color.setHex(S.hemiS); hemi.groundColor.setHex(S.hemiG); hemi.intensity = S.hi;
  sun.color.setHex(S.sun); sun.intensity = S.si; sun.position.set(...S.sunPos);
  renderer.toneMappingExposure = S.exp; outer.material.color.setHex(S.outer); tMat.color.setHex(S.tuft); distMat.color.setHex(S.dist);
  const winter = G.season === 1;
  treeObjs.forEach(t => {
    t.fol.visible = !winter; t.branches.visible = G.season !== 3;
    if (G.season === 0) { t.fm.color.setHex(t.autumn); t.fol.scale.setScalar(.95); }
    else if (G.season === 2) { t.fm.color.setHex(0x9ccc55); t.fol.scale.setScalar(.55); t.fol.visible = true; }
    else if (G.season === 3) { t.fm.color.setHex(0x2f7d32); t.fol.scale.setScalar(1); }
    t.caps.forEach(c => c.visible = winter); t.mound.visible = winter;
  });
  snowShells.forEach(s => s.visible = winter); trailerSnow.visible = winter; markerG.visible = winter;
  cargo.visible = G.cargo > 0 && !winter;
  const alive = (G.season === 3) ? false : true;
  for (let i = 0; i < N * N; i++) if (type[i] === 1 && !bare[i] && G.season !== 3) h[i] = .3;
  markAll();
}

/* ---------- round / season flow ---------- */
function setCargo(v, t) {
  G.cargo = v; cargo.visible = v > 0 && G.season !== 1;
  const sy = .12 + Math.min(.75, v * .0035); cargo.scale.set(1.05, sy, 2.5 * Math.min(1, .4 + v * .01)); cargo.position.y = .85 + sy * .4;
  if (t) cargoMat.color.setHex(t === 'leaf' ? 0xb4682a : 0x4f9a3a);
}
function beginSeason(s) {
  G.season = s; G.round = 0; G.rounds = [rint(3, 4), rint(5, 7), 1, rint(3, 4)][s];
  if (s !== 1) G.hand = 0;
  applySeasonVisuals(); G.tool = SEASON_TOOLS[s][0]; nextRound();
}
function nextRound() {
  G.round++;
  if (G.round > G.rounds) { const ns = (G.season + 1) % 4; if (ns === 0) G.year++; beginSeason(ns); return; }
  startRound();
}
function startRound() {
  const S = SEASONS[G.season]; G.phase = 'play'; G.hand = 0; G.bag = { type: null, n: 0 }; setCargo(0);
  snowPts.visible = G.season === 1;
  banner(`${S.name} · Year ${G.year}`, `${S.task} — round ${G.round} of ${G.rounds}`);
  if (G.season === 0) {
    ls.fill(0); L.quota = 170 + 30 * (G.round - 1); L.spawned = 0; L.dumped = 0; L.acc = 0;
    for (let i = 0; i < MAXL; i++) { dummy.scale.set(0, 0, 0); dummy.updateMatrix(); leafMesh.setMatrixAt(i, dummy.matrix); }
  } else if (G.season === 1) {
    genSnow(); G.snowfall = 5; G.tl = Math.max(150, 220 - 10 * (G.round - 1)); G.fallAcc = 0;
    if (G.round === 1) { G.pileVol = 0; updatePile(); }
  } else if (G.season === 2) {
    pile.scale.set(.01, .01, .01); snow.fill(0); snowT.fill(0); G.pileVol = 0;
    addDrySpots(3, 2.6); G.bareTotal = G.remBare = countBare(); G.regrow = [];
    for (let i = 0; i < N * N; i++) { seeded[i] = 0; watered[i] = 0; }
    G.water = stats().canCap; markAll(); G.seeds = 0;
    if (G.remBare === 0) { completeRound('The lawn is perfect. Nothing to reseed.'); return; }
    openSeedModal();
  } else {
    let c = 0; for (let i = 0; i < N * N; i++) if (type[i] === 1 && !bare[i]) { h[i] = 1; c++; }
    G.uncut = G.cutTotal = Math.max(1, c); G.grow = 0; G.growAcc = 0; markAll();
  }
}
function completeRound(msg) {
  G.phase = 'roundEnd'; G.endTimer = 2.6; toast(msg, 'good'); tone(660, .25, .15); tone(990, .4, .15, .12);
  if (G.round >= G.rounds) toast(`${SEASONS[G.season].name} is done`, 'good');
}
function pickCenter(avoidMark) {
  for (let k = 0; k < 40; k++) {
    const x = rr(-21, 21), z = rr(-13, 21), c = cellAt(x, z);
    if (c >= 0 && type[c] !== 0 && (!avoidMark || Math.hypot(x - MARK.x, z - MARK.z) > 7)) return { x, z };
  } return { x: 0, z: 10 };
}
function genSnow() {
  snowT.fill(0); snow.fill(0);
  const blobs = [{ x: rr(9.5, 11.5), z: rr(-6, 16), r: rr(2.4, 3.2) }];
  const k = Math.min(6, 3 + G.round); for (let i = 0; i < k; i++) { const c = pickCenter(true); blobs.push({ x: c.x, z: c.z, r: rr(2.2, 3.4) }); }
  for (const b of blobs) forCircle(b.x, b.z, b.r, (c, dx, dz) => {
    if (type[c] === 0) return; const d = Math.hypot(dx, dz) / b.r, v = (1 - d * d * .6) * rr(.7, 1);
    snowT[c] = Math.max(snowT[c], Math.min(1, v));
  });
  let V = 0; for (let i = 0; i < N * N; i++) V += snowT[i]; G.V0 = Math.max(1, V);
}
function addDrySpots(blobs, r) {
  for (let b = 0; b < blobs; b++) { const c = pickCenter(false); forCircle(c.x, c.z, r, (i, dx, dz) => { if (type[i] === 1 && Math.random() < 1 - Math.hypot(dx, dz) / r * .5) bare[i] = 1; }); }
}
function rotUnderSnow() {
  let n = 0;
  for (let i = 0; i < N * N; i++) if (snowT[i] > 0 && snow[i] > .04 && type[i] === 1) {
    if (!bare[i]) { bare[i] = 1; n++; }
    const ix = i % N, iz = (i / N) | 0;
    for (let dz = -1; dz <= 1; dz++) for (let dx = -1; dx <= 1; dx++) {
      const a = ix + dx, b = iz + dz; if (a < 0 || b < 0 || a >= N || b >= N) continue;
      const j = b * N + a; if (type[j] === 1 && !bare[j] && Math.random() < .55) { bare[j] = 1; n++; }
    }
  } return n;
}
function updatePile() {
  const v = G.pileVol, r = Math.min(MARK.r - .4, .4 + Math.sqrt(v) * .2), hh = Math.min(2.2, .15 + Math.sqrt(v) * .12);
  pile.scale.set(r, hh, r); pile.position.y = 0;
}

/* ---------- modals (shop, bank, seeds) ---------- */
const modalEl = $('modal'), modalCard = $('modalCard'); let shopTab = 'up';
function lockPointer() { try { const p = canvas.requestPointerLock(); if (p && p.catch) p.catch(() => showPause()); } catch (e) { showPause(); } }
function showPause() { if (G.phase !== 'title' && !G.modal) $('pause').classList.add('show'); }
function openModal(kind) {
  G.modal = kind; G.use = false; modalEl.classList.add('show'); $('pause').classList.remove('show');
  if (document.pointerLockElement) document.exitPointerLock(); renderModal();
}
function closeModal() { G.modal = null; modalEl.classList.remove('show'); lockPointer(); }
function pips(l, m) { let s = ''; for (let i = 0; i < m; i++) s += `<i class="${i < l ? 'f' : ''}"></i>`; return s; }
function renderModal() {
  if (G.modal === 'seed') return renderSeedModal();
  const debtLine = G.debt > 0 ? `<span style="color:var(--bad)">Debt ${money(G.debt)}</span>` : '';
  let body = '';
  if (shopTab === 'up') {
    body = UPG.map(u => { const l = lvl(u.id), mx = l >= u.max, p = upPrice(u, l); return `<div class="row"><div><b>${u.name}</b><span>${u.desc}</span></div><div class="pips">${pips(l, u.max)}</div><button data-act="buy" data-arg="${u.id}" ${mx || G.money < p ? 'disabled' : ''}>${mx ? 'Maxed' : money(p)}</button></div>`; }).join('');
    if (G.season === 2) { const need = Math.max(0, G.remBare - G.seeds); body += `<div class="row"><div><b>Grass seed (20)</b><span>You hold ${G.seeds}. Bare patches still unwatered: ${G.remBare}.</span></div><div></div><button data-act="seeds" ${G.money < SEED_PRICE * 20 ? 'disabled' : ''}>${money(SEED_PRICE * 20)}</button></div>`; }
  } else {
    body = `<div class="bank"><div class="line"><span>Cash</span><b class="num">${money(G.money)}</b></div><div class="line"><span>Debt</span><b class="num" style="color:${G.debt > 0 ? 'var(--bad)' : 'inherit'}">${money(G.debt)}</b></div>
      <p style="margin:0">Loans carry a 10% fee. While you owe money, half of every sale goes straight to the bank.</p>
      <div class="btns">${[500, 1000, 2000].map(a => `<button data-act="loan" data-arg="${a}">Borrow ${money(a)} (repay ${money(a * 1.1)})</button>`).join('')}</div>
      <div class="btns"><button class="ghost" data-act="repay" data-arg="100" ${G.debt <= 0 || G.money < 1 ? 'disabled' : ''}>Repay $100</button><button class="ghost" data-act="repay" data-arg="all" ${G.debt <= 0 || G.money < 1 ? 'disabled' : ''}>Repay as much as possible</button></div></div>`;
  }
  modalCard.innerHTML = `<div class="head"><h2 class="num">Shop & Bank</h2><div class="num" style="font-size:24px">${money(G.money)} ${debtLine}</div></div>
    <div class="tabs"><button data-act="tab" data-arg="up" class="${shopTab === 'up' ? 'on' : ''}">Upgrades</button><button data-act="tab" data-arg="bank" class="${shopTab === 'bank' ? 'on' : ''}">Bank</button></div>${body}
    <div class="btns" style="margin-top:16px"><button data-act="close">Back to the yard</button></div>`;
}
function renderSeedModal() {
  const need = G.remBare, cost = need * SEED_PRICE, short = cost - G.money, afford = Math.floor(G.money / SEED_PRICE);
  let btns;
  if (short <= 0) btns = `<button data-act="seedAll">Buy all ${need} seeds — ${money(cost)}</button>`;
  else {
    const loan = Math.ceil(short / 10) * 10;
    btns = `<button data-act="seedLoan" data-arg="${loan}">Take a ${money(loan)} loan (repay ${money(loan * 1.1)}) and buy all seeds</button>` +
      (afford > 0 ? `<button class="ghost" data-act="seedSome" data-arg="${afford}">Buy what I can afford (${afford} seeds)</button>` : '');
  }
  modalCard.innerHTML = `<h2 class="num">Spring: reseed the lawn</h2>
    <p>${need} patches of lawn are bare, from dry spots and from snow you left too long. Each needs one seed at ${money(SEED_PRICE)}. That is ${money(cost)} and you have ${money(G.money)}.</p>
    ${short > 0 ? `<p style="color:var(--bad)">You are ${money(short)} short. The bank can cover it; the debt is repaid from half of your leaf and grass income.</p>` : ''}
    <div class="btns" style="margin-top:18px">${btns}</div>`;
}
modalCard.addEventListener('click', e => {
  const b = e.target.closest('[data-act]'); if (!b || b.disabled) return; const a = b.dataset.act, arg = b.dataset.arg;
  if (a === 'close') closeModal();
  else if (a === 'tab') { shopTab = arg; renderModal(); }
  else if (a === 'buy') { const u = UPG.find(x => x.id === arg), l = lvl(arg), p = upPrice(u, l); if (l < u.max && G.money >= p) { G.money -= p; G.up[arg] = l + 1; coin(); if (arg === 'can') G.water = stats().canCap; renderModal(); } }
  else if (a === 'seeds') { if (G.money >= SEED_PRICE * 20) { G.money -= SEED_PRICE * 20; G.seeds += 20; coin(); renderModal(); } }
  else if (a === 'loan') { const v = +arg; G.money += v; G.debt += Math.round(v * 1.1); coin(); renderModal(); }
  else if (a === 'repay') { const v = arg === 'all' ? Math.min(G.debt, G.money) : Math.min(+arg, G.debt, G.money); G.money -= v; G.debt -= v; renderModal(); }
  else if (a === 'seedAll') { G.money -= G.remBare * SEED_PRICE; G.seeds += G.remBare; coin(); closeModal(); }
  else if (a === 'seedLoan') { const v = +arg; G.money += v; G.debt += Math.round(v * 1.1); G.money -= G.remBare * SEED_PRICE; G.seeds += G.remBare; toast(`Loan taken: ${money(v)}`, 'bad'); coin(); closeModal(); }
  else if (a === 'seedSome') { const n = +arg; G.money -= n * SEED_PRICE; G.seeds += n; toast('Buy the rest at the shop (E at the shed)'); closeModal(); }
});
function openSeedModal() { openModal('seed'); }

/* ---------- player ---------- */
const P = { x: 2, z: 10, yaw: 0, pitch: -.1, vx: 0, vz: 0, bob: 0 };
const keys = {};
function collide(px, pz, r) {
  for (const R of OBST) {
    const qx = clamp(px, R.x0, R.x1), qz = clamp(pz, R.z0, R.z1); let dx = px - qx, dz = pz - qz; const d2 = dx * dx + dz * dz;
    if (d2 < r * r) {
      if (d2 > 1e-6) { const d = Math.sqrt(d2); px = qx + dx / d * r; pz = qz + dz / d * r; }
      else { const l = px - R.x0, rt = R.x1 - px, t = pz - R.z0, b = R.z1 - pz, m = Math.min(l, rt, t, b); if (m === l) px = R.x0 - r; else if (m === rt) px = R.x1 + r; else if (m === t) pz = R.z0 - r; else pz = R.z1 + r; }
    }
  }
  for (const [tx, tz] of TREES) { const dx = px - tx, dz = pz - tz, d = Math.hypot(dx, dz); if (d < r + .45 && d > 1e-4) { px = tx + dx / d * (r + .45); pz = tz + dz / d * (r + .45); } }
  const B = HALF - .7; px = clamp(px, -B, B); pz = clamp(pz, -B, B); return [px, pz];
}
function movePlayer(dt) {
  const f = (keys.KeyW ? 1 : 0) - (keys.KeyS ? 1 : 0), s = (keys.KeyD ? 1 : 0) - (keys.KeyA ? 1 : 0);
  const sy = Math.sin(P.yaw), cy = Math.cos(P.yaw);
  let mx = -sy * f + cy * s, mz = -cy * f - sy * s; const l = Math.hypot(mx, mz); if (l > 0) { mx /= l; mz /= l; }
  let sp = (keys.ShiftLeft || keys.ShiftRight) ? 7 : 4.6;
  if (G.tool === 3 && G.season === 3 && G.use) sp *= .85;
  if (G.hand > 0) sp *= 1 - Math.min(.25, G.hand / 80);
  const c = cellAt(P.x, P.z); if (c >= 0) sp *= 1 - snow[c] * .22;
  const k = Math.min(1, 12 * dt); P.vx += (mx * sp - P.vx) * k; P.vz += (mz * sp - P.vz) * k;
  const [nx, nz] = collide(P.x + P.vx * dt, P.z + P.vz * dt, .45); P.x = nx; P.z = nz;
  P.speed = Math.hypot(P.vx, P.vz); P.bob += P.speed * dt * 1.7;
}

/* ---------- leaves ---------- */
function spawnLeaf() {
  let i = -1; for (let k = 0; k < MAXL; k++) if (ls[k] === 0) { i = k; break; } if (i < 0) return false;
  let x = 0, z = 0;
  for (let t = 0; t < 8; t++) {
    if (Math.random() < .75) { const tr = TREES[rint(0, TREES.length - 1)]; x = tr[0] + (Math.random() + Math.random() - 1) * 6; z = tr[1] + (Math.random() + Math.random() - 1) * 6; }
    else { x = rr(-22, 22); z = rr(-22, 22); }
    const c = cellAt(x, z); if (c >= 0 && type[c] !== 0) break;
  }
  lx[i] = clamp(x, -22.5, 22.5); lz[i] = clamp(z, -22.5, 22.5); ly[i] = rr(5.5, 8.5); lvx[i] = lvz[i] = 0;
  lrot[i] = rr(0, 6.28); lfall[i] = rr(1.1, 1.9); ltw[i] = rr(0, 6.28); ls[i] = 1; L.spawned++; return true;
}
function hideLeaf(i) { ls[i] = 3; dummy.scale.set(0, 0, 0); dummy.updateMatrix(); leafMesh.setMatrixAt(i, dummy.matrix); }
function dumpLeaves(n) {
  if (n <= 0) return; L.dumped += n; income(n * LEAF_PRICE); setCargo(G.cargo + n, 'leaf');
}
function updateLeaves(dt) {
  let live = 0;
  for (let i = 0; i < MAXL; i++) {
    const s = ls[i]; if (s === 0 || s === 3) continue; live++;
    let rx = -Math.PI / 2, rz = 0;
    if (s === 1) {
      ly[i] -= lfall[i] * dt; lx[i] += Math.sin(G.time * 1.7 + i) * .55 * dt; lz[i] += Math.cos(G.time * 1.3 + i * 2) * .55 * dt; ltw[i] += 3 * dt;
      rx += Math.sin(ltw[i]) * 1.1; rz = Math.cos(ltw[i]) * .6;
      if (ly[i] <= .03) {
        const c = cellAt(lx[i], lz[i]);
        if (c < 0 || type[c] === 0) { if (inRect(lx[i], lz[i], { x0: RECT.trailer.x0 - .3, x1: RECT.trailer.x1 + .3, z0: RECT.trailer.z0 - .3, z1: RECT.trailer.z1 + .3 })) dumpLeaves(1); else L.quota--; hideLeaf(i); continue; }
        ly[i] = .03; ls[i] = 2;
      }
    } else {
      const sp = Math.hypot(lvx[i], lvz[i]);
      if (sp > .02) {
        const nx = lx[i] + lvx[i] * dt, nz = lz[i] + lvz[i] * dt;
        if (inRect(nx, nz, RECT.trailer, .25)) { dumpLeaves(1); hideLeaf(i); continue; }
        if (inRect(nx, nz, RECT.house, .1) || inRect(nx, nz, RECT.shed, .1)) { lvx[i] *= -.25; lvz[i] *= -.25; }
        else {
          lx[i] = nx; lz[i] = nz;
          if (Math.abs(nx) > 23.3) { lx[i] = clamp(nx, -23.3, 23.3); lvx[i] *= -.3; } if (Math.abs(nz) > 23.3) { lz[i] = clamp(nz, -23.3, 23.3); lvz[i] *= -.3; }
        }
        const dec = Math.exp(-2.4 * dt); lvx[i] *= dec; lvz[i] *= dec; lrot[i] += sp * dt * 1.5;
        ly[i] = .03 + Math.min(.5, sp * .05);
      } else { lvx[i] = lvz[i] = 0; ly[i] = .03; }
    }
    const big = (L.spawned >= L.quota && L.quota - L.dumped - G.bag.n <= 8) ? 2.4 : 1;
    dummy.position.set(lx[i], ly[i] + (big > 1 ? .06 : 0), lz[i]); dummy.rotation.set(rx, 0, lrot[i] + rz); dummy.scale.set(big, big, big);
    dummy.updateMatrix(); leafMesh.setMatrixAt(i, dummy.matrix);
  }
  leafMesh.instanceMatrix.needsUpdate = true; return live;
}

/* ---------- tool actions ---------- */
function rake(dt, fx, fz, st) {
  let any = false; const cosA = Math.cos(st.rakeA);
  for (let i = 0; i < MAXL; i++) {
    if (ls[i] !== 2) continue; const dx = lx[i] - P.x, dz = lz[i] - P.z, d = Math.hypot(dx, dz);
    if (d > st.rakeR || d < .001 || (dx * fx + dz * fz) / d < cosA) continue; any = true;
    if (d < .85) { if (bagCanAdd('leaf')) { addBag('leaf'); hideLeaf(i); } else hint('Bag full. Empty it at the trailer (E).'); }
    else { lvx[i] = -dx / d * 5.5; lvz[i] = -dz / d * 5.5; }
  } return any;
}
function blower(dt, fx, fz, st) {
  let any = false; const cosA = Math.cos(.62);
  for (let i = 0; i < MAXL; i++) {
    if (ls[i] !== 2) continue; const dx = lx[i] - P.x, dz = lz[i] - P.z, d = Math.hypot(dx, dz);
    if (d > st.blowR || d < .2 || (dx * fx + dz * fz) / d < cosA) continue;
    const k = (1.15 - d / st.blowR) * st.blowF * dt * 9; lvx[i] += fx * k + (Math.random() - .5) * k * .6; lvz[i] += fz * k + (Math.random() - .5) * k * .6;
    const sp = Math.hypot(lvx[i], lvz[i]); if (sp > 11) { lvx[i] *= 11 / sp; lvz[i] *= 11 / sp; } any = true;
  } return any;
}
function shovelTool(dt, fx, fz, st) {
  if (G.snowfall > 0) { hint('Wait for the snowfall to stop.'); return false; }
  if (G.hand >= st.handCap - 1e-6) { hint('Shovel full. Carry it to the orange marker (E).'); return false; }
  let took = 0; const room = st.handCap - G.hand;
  forCircle(P.x + fx * 1.8, P.z + fz * 1.8, st.shovR, c => {
    if (snow[c] <= 0) return; const t = Math.min(snow[c], st.shovRate * dt, room - took); snow[c] -= t; took += t;
    if (snow[c] < .05) { took += snow[c]; snow[c] = 0; } mark(c); if (took >= room) return false;
  });
  if (took > 0) { G.hand += took; snowDirty = true; G.scoopT -= dt; if (G.scoopT <= 0) { burst(1500, .14, .22); G.scoopT = .28; } }
  return took > 0;
}
function mower(dt, fx, fz, st) {
  forCircle(P.x + fx * 1.55, P.z + fz * 1.55, st.mowR, c => {
    if (type[c] === 1 && !bare[c] && h[c] > .5) {
      if (!bagCanAdd('grass')) { hint('Grass bag full. Empty it at the trailer (E).'); return false; }
      h[c] = .05; addBag('grass'); G.uncut--; mark(c);
    }
  }); return true;
}
function seedTool(dt, fx, fz, st) {
  G.seedCD -= dt; if (G.seedCD > 0) return false;
  if (G.seeds <= 0) { hint('Out of seed. Buy more at the shop (E at the shed).'); return false; }
  let n = 0; forCircle(P.x + fx * 2.2, P.z + fz * 2.2, st.seedR, c => { if (type[c] === 1 && bare[c] && !seeded[c] && G.seeds > 0) { seeded[c] = 1; G.seeds--; n++; mark(c); } });
  if (n > 0) { G.seedCD = st.seedCD; burst(5200, .1, .12, 'highpass'); } return n > 0;
}
function waterTool(dt, fx, fz, st) {
  if (G.water <= 0) { hint('Can empty. Refill at the tap on the house wall (E).'); return false; }
  let n = 0; G.water = Math.max(0, G.water - .3 * dt);
  forCircle(P.x + fx * 2.4, P.z + fz * 2.4, st.canR, c => {
    if (type[c] === 1 && bare[c] && seeded[c] && !watered[c] && G.water >= .1) { watered[c] = 1; G.water -= .1; G.remBare--; G.regrow.push({ i: c, t: rr(2.5, 4.5), ph: 1 }); n++; mark(c); }
  }); return true;
}
function useTool(dt) {
  const st = stats(), fx = -Math.sin(P.yaw), fz = -Math.cos(P.yaw), t = G.tool; let a = false;
  const ok = SEASON_TOOLS[G.season].includes(t);
  if (G.use && !ok) { hint(`${TOOLS[t]} is not needed in ${SEASONS[G.season].name}.`); }
  if (ok) {
    const auto = t === 4 && st.seedAuto && P.speed > .5;
    if (G.use || auto) {
      if (t === 0) a = rake(dt, fx, fz, st); else if (t === 1) a = blower(dt, fx, fz, st); else if (t === 2) a = shovelTool(dt, fx, fz, st);
      else if (t === 3) a = mower(dt, fx, fz, st); else if (t === 4) a = seedTool(dt, fx, fz, st); else if (t === 5) a = waterTool(dt, fx, fz, st);
    }
  }
  G.working = a; G.engine = ok && G.use && t === 3;
}

/* ---------- interactions (E key) ---------- */
function findAction() {
  const d = (a, b) => Math.hypot(P.x - a, P.z - b), c = [];
  if (G.bag.n > 0) { const dd = d(TRAILER_C.x, TRAILER_C.z); if (dd < 5.5) c.push({ k: 'trailer', d: dd, label: `Empty the bag into the trailer (+${money(G.bag.type === 'leaf' ? G.bag.n * LEAF_PRICE : bagUnits() * GRASS_UNIT_PRICE)})` }); }
  if (G.hand > 0.01 && G.season === 1) { const dd = d(MARK.x, MARK.z); if (dd < MARK.r + 1.5) c.push({ k: 'marker', d: dd, label: 'Dump the snow on the pile' }); }
  if (G.season === 2) { const dd = d(TAP.x, TAP.z); if (dd < 3.2) c.push({ k: 'tap', d: dd, label: 'Refill the watering can' }); }
  { const dd = d(SHED_C.x, SHED_C.z); if (dd < 5.5) c.push({ k: 'shop', d: dd, label: 'Open the shop & bank' }); }
  c.sort((a, b) => a.d - b.d); return c[0] || null;
}
function interact() {
  const a = findAction(); if (!a) return;
  if (a.k === 'trailer') {
    const { type: t, n } = G.bag;
    if (t === 'leaf') { L.dumped += n; income(n * LEAF_PRICE); setCargo(G.cargo + n, 'leaf'); }
    else { income(bagUnits() * GRASS_UNIT_PRICE); setCargo(G.cargo + bagUnits() * 6, 'grass'); }
    G.bag = { type: null, n: 0 }; coin();
  } else if (a.k === 'marker') { G.pileVol += G.hand; G.hand = 0; updatePile(); burst(300, .3, .3, 'lowpass'); }
  else if (a.k === 'tap') { G.water = stats().canCap; burst(3000, .6, .2, 'highpass'); toast('Watering can refilled'); }
  else if (a.k === 'shop') { shopTab = 'up'; openModal('shop'); }
}

/* ---------- per-season simulation ---------- */
function updateRegrow(dt) {
  for (let k = G.regrow.length - 1; k >= 0; k--) {
    const r = G.regrow[k]; r.t -= dt;
    if (r.ph === 1) { if (r.t <= 0) { bare[r.i] = 0; seeded[r.i] = 0; watered[r.i] = 0; h[r.i] = .05; r.ph = 2; r.t = 3; r.T = 3; mark(r.i); } }
    else { h[r.i] = .05 + .25 * (1 - Math.max(0, r.t) / r.T); mark(r.i); if (r.t <= 0) { h[r.i] = .3; G.regrow.splice(k, 1); } }
  }
}
function seasonUpdate(dt) {
  const st = stats();
  if (G.season === 0) {
    if (L.spawned < L.quota) { L.acc += dt * L.quota / 32; while (L.acc >= 1 && L.spawned < L.quota) { L.acc--; spawnLeaf(); } }
    const live = updateLeaves(dt);
    if (L.spawned >= L.quota && live === 0 && G.bag.n === 0) completeRound(`Round cleared. ${L.dumped} leaves hauled away.`);
    else if (L.spawned >= L.quota && live === 0 && G.bag.n > 0) hint('Everything is raked. Empty the bag at the trailer (E).');
  } else if (G.season === 1) {
    if (G.snowfall > 0) {
      G.snowfall -= dt; G.fallAcc += dt;
      if (G.fallAcc > .2 || G.snowfall <= 0) { G.fallAcc = 0; const p = 1 - Math.max(0, G.snowfall) / 5; for (let i = 0; i < N * N; i++) if (snowT[i] > 0) { snow[i] = snowT[i] * p; mark(i); } snowDirty = true; }
      return;
    }
    G.tl -= dt; let V = 0; for (let i = 0; i < N * N; i++) V += snow[i]; G.V = V;
    if (V < .15 && G.hand < .05) { for (let i = 0; i < N * N; i++) if (snow[i] > 0) { snow[i] = 0; mark(i); } snowDirty = true; completeRound(`Snow cleared with ${Math.max(0, Math.ceil(G.tl))}s to spare.`); }
    else if (G.tl <= 0) {
      const n = rotUnderSnow(); snow.fill(0); snowT.fill(0); G.hand = 0; markAll();
      toast(`Out of time! ${n} lawn patches rotted under the snow.`, 'bad'); completeRound(n ? 'Expect more reseeding in spring.' : 'Close call. The lawn survived.');
    }
  } else if (G.season === 2) {
    updateRegrow(dt);
    if (G.remBare <= 0 && G.phase === 'play') completeRound('The lawn is reseeded and watered.');
  } else {
    if (G.grow < 1) { G.grow = Math.min(1, G.grow + dt / 6); G.growAcc += dt; if (G.growAcc > .15) { G.growAcc = 0; refreshAllTufts(); } }
    if (G.uncut <= 0 && G.bag.n === 0) completeRound('Lawn mowed and clippings sold.');
    else if (G.uncut <= 0) hint('Lawn is done. Empty the bag at the trailer (E).');
  }
}

/* ---------- input ---------- */
document.addEventListener('keydown', e => {
  if (e.code === 'Tab') e.preventDefault();
  if (G.modal) { if (e.code === 'Escape' && G.modal === 'shop') closeModal(); return; }
  keys[e.code] = true;
  if (!G.locked) return;
  if (e.code.startsWith('Digit')) { const n = +e.code.slice(5); if (n >= 1 && n <= 6) G.tool = n - 1; }
  if (e.code === 'KeyE') interact();
  if (e.code === 'KeyM') { AU.mute = !AU.mute; toast(AU.mute ? 'Sound off' : 'Sound on'); }
});
document.addEventListener('keyup', e => { keys[e.code] = false; });
addEventListener('blur', () => { for (const k in keys) keys[k] = false; G.use = false; });
document.addEventListener('mousemove', e => {
  if (!G.locked) return; P.yaw -= e.movementX * .0022; P.pitch = clamp(P.pitch - e.movementY * .0022, -1.45, 1.45);
});
document.addEventListener('mousedown', e => { if (G.locked && e.button === 0) G.use = true; });
document.addEventListener('mouseup', e => { if (e.button === 0) G.use = false; });
document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('wheel', e => { if (!G.locked) return; G.tool = (G.tool + (e.deltaY > 0 ? 1 : 5)) % 6; }, { passive: true });
document.addEventListener('pointerlockchange', () => {
  G.locked = document.pointerLockElement === canvas;
  if (G.locked) $('pause').classList.remove('show'); else { G.use = false; for (const k in keys) keys[k] = false; showPause(); }
});
document.addEventListener('pointerlockerror', showPause);
$('pause').addEventListener('click', () => { $('pause').classList.remove('show'); lockPointer(); });
$('startBtn').addEventListener('click', () => {
  initAudio(); $('title').classList.remove('show'); $('hud').style.display = 'block';
  G.phase = 'play'; beginSeason(0); lockPointer();
});

/* ---------- HUD refresh (10 Hz) ---------- */
let hudT = 0;
function updateHUD(dt) {
  hudT -= dt; if (hudT > 0) return; hudT = .1;
  const S = SEASONS[G.season], st = stats();
  $('seasonName').textContent = `${S.name} · Year ${G.year}`;
  $('roundLine').textContent = `${S.task} ${G.round}/${G.rounds}`;
  let prog = 0, timer = '';
  if (G.season === 0) prog = L.quota > 0 ? L.dumped / L.quota : 0;
  else if (G.season === 1) { prog = G.snowfall > 0 ? 0 : 1 - ((G.V || 0) + G.hand) / G.V0; if (G.snowfall > 0) timer = 'Snow is falling…'; else { const t = Math.max(0, Math.ceil(G.tl)); timer = `Clear it before the lawn rots: ${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`; } }
  else if (G.season === 2) prog = 1 - G.remBare / Math.max(1, G.bareTotal);
  else prog = 1 - G.uncut / G.cutTotal;
  $('progBar').style.width = (clamp(prog, 0, 1) * 100).toFixed(1) + '%';
  const te = $('timer'); te.textContent = timer; te.classList.toggle('low', G.season === 1 && G.tl < 30 && G.snowfall <= 0);
  $('money').textContent = money(G.money);
  const de = $('debt'); de.style.display = G.debt > 0 ? 'block' : 'none'; if (G.debt > 0) de.textContent = `Debt ${money(G.debt)} · half of sales repays it`;
  const bu = bagUnits(); $('bagLab').textContent = G.bag.type === 'leaf' ? 'Bag · leaves' : G.bag.type === 'grass' ? 'Bag · clippings' : 'Bag';
  $('bagTxt').textContent = `${bu.toFixed(1)} / ${st.bagCap}`; $('bagBar').style.width = (clamp(bu / st.bagCap, 0, 1) * 100) + '%';
  $('stHand').classList.toggle('hide', G.season !== 1); $('handTxt').textContent = `${G.hand.toFixed(1)} / ${st.handCap}`; $('handBar').style.width = (clamp(G.hand / st.handCap, 0, 1) * 100) + '%';
  $('stSeed').classList.toggle('hide', G.season !== 2); $('seedTxt').textContent = `${G.seeds}`;
  $('stWater').classList.toggle('hide', G.season !== 2); $('waterTxt').textContent = `${G.water.toFixed(1)} / ${st.canCap}`; $('waterBar').style.width = (clamp(G.water / st.canCap, 0, 1) * 100) + '%';
  slots.forEach((s, i) => { s.classList.toggle('on', i === G.tool); s.classList.toggle('need', SEASON_TOOLS[G.season].includes(i)); });
  const a = G.action = (G.phase === 'play' || G.phase === 'roundEnd') ? findAction() : null, pr = $('prompt');
  if (a) { pr.style.display = 'block'; pr.innerHTML = `<kbd>E</kbd>${a.label}`; }
  else if (G.hintT > 0 && G.hint) { pr.style.display = 'block'; pr.textContent = G.hint; }
  else pr.style.display = 'none';
}

/* ---------- main loop ---------- */
const clock = { last: performance.now() };
function frame(now) {
  requestAnimationFrame(frame);
  const dt = Math.min(.05, (now - clock.last) / 1000); clock.last = now;
  const running = G.locked && !G.modal && G.phase !== 'title';
  if (running) {
    G.time += dt; movePlayer(dt);
    G.hintT -= dt;
    if (G.phase === 'play') { seasonUpdate(dt); if (G.phase === 'play') useTool(dt); }
    else if (G.phase === 'roundEnd') { G.working = false; G.endTimer -= dt; if (G.endTimer <= 0) { G.phase = 'fade'; fadeTo(nextRound); } }
    G.incT -= dt;
    if (G.incT <= 0 && G.incAcc > 0) { toast(`+${money(G.incAcc)}`, 'good'); coin(); G.incAcc = 0; if (G.incRep) { toast(`Loan repayment ${money(G.incRep)}`); G.incRep = 0; } }
  } else { G.working = false; G.engine = false; }
  if (snowDirty) { G.snowT = (G.snowT || 0) - dt; if (G.snowT <= 0) { updateSnowMesh(); snowDirty = false; G.snowT = .08; } }
  flush();

  // camera
  if (G.phase === 'title') {
    const a = now * .00007; camera.position.set(Math.cos(a) * 20, 6.5, Math.sin(a) * 20 + 4); camera.lookAt(0, 2, -4);
  } else {
    camera.position.set(P.x, 1.7 + Math.sin(P.bob) * .035 * Math.min(1, (P.speed || 0) / 4), P.z);
    camera.rotation.set(P.pitch, P.yaw, 0);
  }
  sky.position.copy(camera.position); sun.target.position.set(0, 0, 0);

  // tools animation
  tools.forEach((t, i) => t.visible = (i === G.tool && G.phase !== 'title'));
  const tg = tools[G.tool];
  if (tg) {
    const b = tg.userData.base, w = G.working, tt = G.time; let ox = 0, oy = Math.sin(P.bob) * .012, oz = 0, rx = 0, rz = 0;
    if (G.tool === 0 && w) { oz = Math.sin(tt * 9) * .12; rx = Math.sin(tt * 9) * .12; }
    else if (G.tool === 1 && w) { oz = .03; ox = Math.sin(tt * 50) * .003; }
    else if (G.tool === 2 && w) { rx = Math.sin(tt * 6) * .25; oy -= .04; }
    else if (G.tool === 3 && (G.engine)) { oy += Math.sin(tt * 60) * .004; ox = Math.sin(tt * 47) * .003; }
    else if (G.tool === 5 && w) { rz = -.45; rx = -.2; }
    tg.position.set(b[0] + ox, b[1] + oy, b[2] + oz); tg.rotation.set(b[3] + rx, b[4], b[5] + rz);
  }

  // snow particles follow the player
  if (snowPts.visible) {
    const heavy = G.season === 1 && G.snowfall > 0; snowGeo.setDrawRange(0, heavy ? SNOWN : 350);
    const cxp = G.phase === 'title' ? 0 : P.x, czp = G.phase === 'title' ? 0 : P.z;
    for (let i = 0; i < SNOWN; i++) {
      const o = i * 3; snowPos[o + 1] -= (2 + (i % 5) * .4) * dt; snowPos[o] += Math.sin(now * .0006 + i) * .4 * dt;
      if (snowPos[o + 1] < 0) snowPos[o + 1] += 18;
      if (snowPos[o] < cxp - 22) snowPos[o] += 44; else if (snowPos[o] > cxp + 22) snowPos[o] -= 44;
      if (snowPos[o + 2] < czp - 22) snowPos[o + 2] += 44; else if (snowPos[o + 2] > czp + 22) snowPos[o + 2] -= 44;
    }
    snowGeo.attributes.position.needsUpdate = true;
  }

  // audio levels
  const w = G.working && G.phase === 'play';
  setLoop(AU.blow, w && G.tool === 1 ? .34 : 0); setLoop(AU.rake, w && G.tool === 0 ? .1 : 0);
  setLoop(AU.water, w && G.tool === 5 ? .12 : 0);
  setLoop(AU.mow, G.engine ? .2 : 0);
  if (AU.ctx && AU.og) { AU.og.gain.setTargetAtTime(AU.mute || !G.engine ? 0 : .09, AU.ctx.currentTime, .08); AU.osc.frequency.setTargetAtTime(w ? 74 : 58, AU.ctx.currentTime, .15); }

  updateHUD(dt);
  renderer.render(scene, camera);
}

/* ---------- boot ---------- */
applySeasonVisuals(); updateSnowMesh(); flush(); refreshAllTufts();
requestAnimationFrame(t => { clock.last = t; frame(t); });
}
</script>
</body>
</html>
