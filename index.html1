  for (let d = 0; d <= len; d += 3) { const t = d / len; m4.makeRotationY(rotY); m4.setPosition(x0 + (x1 - x0) * t, .8, z0 + (z1 - z0) * t); fence.ps.push(m4.clone()); }
  const mx = (x0 + x1) / 2, mz = (z0 + z1) / 2;
  for (const y of [.35, 1.0]) { const r = new THREE.Mesh(rotY === 0 ? new THREE.BoxGeometry(len, .07, .05) : new THREE.BoxGeometry(.05, .07, len), M.wood); r.position.set(mx, y, mz); r.castShadow = true; scene.add(r); }
}
