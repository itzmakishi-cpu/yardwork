  const gs = new THREE.Shape(); gs.moveTo(-d / 2, 0); gs.lineTo(d / 2, 0); gs.lineTo(0, d * .29);
  for (const sx of [-w / 2 - .02, w / 2 + .02]) { const gm = new THREE.Mesh(new THREE.ShapeGeometry(gs), sm); gm.material.side = THREE.DoubleSide; gm.rotation.y = Math.PI / 2; gm.position.set(sx, hh, 0); g.add(gm); }
  for (let k = 0; k < 4; k++) { const wx = -w / 2 + (k + .7) * w / 4.4; box(1.6, 1.5, .1, M.white, wx, 3, d / 2 + .02, g, false); const gl = new THREE.Mesh(new THREE.PlaneGeometry(1.4, 1.3), std({ color: 0x20303f, roughness: .1, metalness: .5, emissive: 0x0a1220 })); gl.position.set(wx, 3, d / 2 + .08, 0); g.add(gl); }
  box(1.3, 2.3, .12, mat(0x5a3a28, .7), w * .15, 1.15, d / 2 + .03, g); box(.4, 2.2, .4, mat(0x7b4a3a, .9), -w * .3, hh + 2.1, 0, g);
  return g;
}
