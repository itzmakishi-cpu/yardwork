<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Yardwork: Four Seasons</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#eef2f5;--mute:#a9b5bf;--panel:rgba(13,21,29,.76);--line:rgba(255,255,255,.14);--hi:#f2b632;--bad:#ff7a6b;--good:#8fdcae;
  font-family:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#0b1118;color:var(--ink)}
#c{position:fixed;inset:0;width:100%;height:100%;display:block;outline:none}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:10px;backdrop-filter:blur(6px);padding:10px 14px}
.num{font-family:'Barlow Condensed','Barlow',sans-serif;font-weight:700;letter-spacing:.01em}
#hud{position:fixed;inset:0;pointer-events:none;display:none;z-index:2}
#season{position:absolute;left:18px;top:18px;width:300px}
#seasonName{font-size:26px;line-height:1}
#roundLine{color:var(--mute);font-size:14px;margin-top:4px}
.bar{height:8px;background:rgba(255,255,255,.12);border-radius:5px;overflow:hidden;margin-top:8px}
.bar i{display:block;height:100%;width:0;background:var(--hi);transition:width .25s}
#timer{margin-top:6px;font-size:15px;color:var(--mute)}
#timer.low{color:var(--bad)}
#wallet{position:absolute;right:18px;top:18px;text-align:right;min-width:170px}
#money{font-size:34px;line-height:1}
#debt{font-size:14px;color:var(--bad);margin-top:4px;display:none}
#stats{position:absolute;left:18px;bottom:18px;width:290px;display:grid;gap:9px}
.stat .lab{display:flex;justify-content:space-between;font-size:13px;color:var(--mute);margin-bottom:3px}
.stat .lab b{color:var(--ink);font-weight:600}
.stat .bar{margin-top:0}
.stat.hide{display:none}
#hotbar{position:absolute;left:50%;bottom:18px;transform:translateX(-50%);display:flex;gap:8px}
.slot{width:86px;padding:7px 6px 8px;text-align:center;border-radius:10px;background:var(--panel);border:1px solid var(--line);position:relative}
.slot .k{font-size:12px;color:var(--mute)}
.slot .n{font-size:15px;line-height:1.1;margin-top:2px}
.slot.on{border-color:var(--hi);box-shadow:0 0 0 1px var(--hi) inset;background:rgba(242,182,50,.16)}
.slot.need::after{content:"";position:absolute;right:7px;top:7px;width:7px;height:7px;border-radius:50%;background:var(--hi)}
#cross{position:absolute;left:50%;top:50%;width:6px;height:6px;margin:-3px;border-radius:50%;background:rgba(255,255,255,.85);box-shadow:0 0 0 1px rgba(0,0,0,.5)}
#prompt{position:absolute;left:50%;top:62%;transform:translateX(-50%);padding:8px 16px;border-radius:8px;background:var(--panel);border:1px solid var(--line);font-size:17px;display:none;white-space:nowrap}
#prompt kbd{background:var(--hi);color:#1a1405;border-radius:5px;padding:1px 8px;font-weight:700;margin-right:8px}
#toasts{position:absolute;right:18px;top:100px;display:grid;gap:6px;justify-items:end}
.toast{padding:8px 14px;border-radius:8px;background:var(--panel);border:1px solid var(--line);font-size:15px;animation:toast 3.6s forwards}
.toast.good{border-color:var(--good)}.toast.bad{border-color:var(--bad)}
@keyframes toast{0%{opacity:0;transform:translateY(-6px)}8%{opacity:1;transform:none}85%{opacity:1}100%{opacity:0}}
#banner{position:absolute;left:0;right:0;top:20%;text-align:center;opacity:0;pointer-events:none}
#banner h1{font-size:76px;line-height:1;text-shadow:0 3px 24px rgba(0,0,0,.55)}
#banner p{font-size:22px;margin-top:8px;text-shadow:0 2px 12px rgba(0,0,0,.6)}
#banner.show{animation:banner 3.2s forwards}
@keyframes banner{0%{opacity:0;transform:scale(.96)}12%{opacity:1;transform:none}75%{opacity:1}100%{opacity:0}}
.overlay{position:fixed;inset:0;display:none;align-items:center;justify-content:center;background:rgba(6,10,14,.66);z-index:10;padding:16px}
.overlay.show{display:flex}
#title{background:linear-gradient(180deg,rgba(6,10,14,.35),rgba(6,10,14,.82))}
.card{background:#111c26;border:1px solid var(--line);border-radius:14px;padding:26px 30px;max-width:680px;width:100%;box-shadow:0 20px 60px rgba(0,0,0,.5);max-height:92vh;overflow:auto}
.card h1{font-size:54px;line-height:1}
.card h2{font-size:30px;line-height:1.05}
.card p{color:var(--mute);line-height:1.45;margin-top:10px;font-size:16px}
.keys{display:grid;grid-template-columns:1fr 1fr;gap:6px 22px;margin:18px 0;font-size:15px}
.keys span{color:var(--mute)}
.keys b{color:var(--hi);font-weight:600}
button{font:inherit;cursor:pointer;border:0;border-radius:9px;padding:10px 18px;background:var(--hi);color:#1a1405;font-weight:700;font-size:16px}
button:hover:not(:disabled){filter:brightness(1.1)}
button:disabled{background:#2a3743;color:#6e7c88;cursor:not-allowed}
button.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.tabs{display:flex;gap:8px;margin:16px 0 8px}
.tabs button{background:transparent;color:var(--mute);border:1px solid var(--line);padding:7px 14px}
.tabs button.on{color:#1a1405;background:var(--hi);border-color:var(--hi)}
.row{display:grid;grid-template-columns:1fr auto 96px;gap:14px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}
.row b{display:block;font-size:16px}.row span{display:block;color:var(--mute);font-size:13px;margin-top:2px}
.pips{display:flex;gap:4px}.pips i{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.16)}.pips i.f{background:var(--hi)}
.bank{display:grid;gap:12px;margin-top:10px}
.bank .line{display:flex;justify-content:space-between;font-size:17px}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
#fade{position:fixed;inset:0;background:#000;opacity:0;pointer-events:none;transition:opacity .6s;z-index:9}
#fade.on{opacity:1}
@media (max-width:900px){#hotbar .slot{width:62px}#banner h1{font-size:44px}#season,#stats{width:230px}}
</style>
</head>
<body>
<canvas id="c" tabindex="0"></canvas>

<div id="hud">
  <div id="season" class="panel">
    <div id="seasonName" class="num"></div>
    <div id="roundLine"></div>
    <div class="bar"><i id="progBar"></i></div>
    <div id="timer"></div>
  </div>
  <div id="wallet" class="panel">
    <div id="money" class="num">$0</div>
    <div id="debt"></div>
  </div>
  <div id="toasts"></div>
  <div id="cross"></div>
  <div id="prompt"></div>
  <div id="banner"><h1 class="num" id="bannerT"></h1><p id="bannerS"></p></div>
  <div id="stats" class="panel">
    <div class="stat" id="stBag"><div class="lab"><span id="bagLab">Bag</span><b id="bagTxt"></b></div><div class="bar"><i id="bagBar"></i></div></div>
    <div class="stat hide" id="stHand"><div class="lab"><span>Shovel load</span><b id="handTxt"></b></div><div class="bar"><i id="handBar"></i></div></div>
    <div class="stat hide" id="stSeed"><div class="lab"><span>Grass seed</span><b id="seedTxt"></b></div></div>
    <div class="stat hide" id="stWater"><div class="lab"><span>Water</span><b id="waterTxt"></b></div><div class="bar"><i id="waterBar"></i></div></div>
  </div>
  <div id="hotbar"></div>
</div>

<div id="title" class="overlay show">
  <div class="card">
    <h1 class="num">Yardwork: Four Seasons</h1>
    <p>One yard, one trailer, one year that keeps repeating. Rake the autumn leaves, shovel winter snow before the lawn rots, reseed in spring, and mow in summer. Spend what you earn on better gear, and borrow from the bank when winter wrecks your lawn.</p>
    <div class="keys">
      <div><b>W A S D</b> <span>move</span></div><div><b>Shift</b> <span>sprint</span></div>
      <div><b>Mouse</b> <span>look</span></div><div><b>Left click</b> <span>use tool (hold)</span></div>
      <div><b>1 – 6 / Wheel</b> <span>switch tool</span></div><div><b>E</b> <span>dump, refill, shop</span></div>
      <div><b>M</b> <span>mute</span></div><div><b>Esc</b> <span>pause</span></div>
    </div>
    <button id="startBtn">Click to start</button>
  </div>
</div>
<div id="pause" class="overlay"><div class="card"><h2 class="num">Paused</h2><p>Click anywhere to return to the yard. The clock stops while you are paused.</p><div class="btns"><button id="resumeBtn">Resume</button></div></div></div>
<div id="modal" class="overlay"><div class="card" id="modalCard"></div></div>
<div id="fade"></div>
<div id="err" class="overlay"><div class="card"><h2 class="num">The game could not start</h2><p></p></div></div>

<script type="module">
/* =====================================================================
   YARDWORK: FOUR SEASONS
   Single-file 3D first-person yard-work sim. Three.js (ES module via CDN).
   Physics are a lightweight custom solver (circle vs. box collisions and
   velocity-based leaf dynamics), so there is only one CDN dependency.
   ===================================================================== */

// ---------- Load Three.js with CDN fallbacks ----------
async function loadThree() {
  const urls = [
    'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js',
    'https://unpkg.com/three@0.160.0/build/three.module.js',
    'https://esm.sh/three@0.160.0'
  ];
  for (const u of urls) {
    try { return await import(u); } catch (e) { console.warn('CDN failed:', u, e); }
  }
  throw new Error('Could not load Three.js from any CDN. Check your internet connection and reload.');
}
function fatal(msg) {
  const e = document.getElementById('err');
  e.classList.add('show');
  e.querySelector('p').textContent = msg;
}
let THREE;
try { THREE = await loadThree(); await main(); }
catch (e) { console.error(e); fatal(e && e.message ? e.message : String(e)); }

async function main() {
/* ---------- tiny helpers ---------- */
const $ = id => document.getElementById(id);
const rr = (a, b) => a + Math.random() * (b - a);
const rint = (a, b) => a + Math.floor(Math.random() * (b - a + 1));
const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
const money = v => '$' + Math.round(v).toLocaleString('en-US');

/* ---------- world constants ---------- */
const N = 48, HALF = 24;                       // 48 x 48 one-metre cells
const cx = ix => -HALF + ix + 0.5, cz = iz => -HALF + iz + 0.5;
const RECT = {
  house:   { x0: -12,   x1: 14,   z0: -24,   z1: -15 },
  shed:    { x0: -20.5, x1: -15.5, z0: -10.5, z1: -5.5 },
  trailer: { x0: 16.5,  x1: 19.5, z0: 1.2,   z1: 6.8 }
};
const OBST = [RECT.house, RECT.shed, RECT.trailer];
const DRIVE = { x0: 8, x1: 13, z0: -15, z1: 24 };
const TRAILER_C = { x: 18, z: 4 }, SHED_C = { x: -18, z: -8 }, TAP = { x: 0, z: -14.2 }, MARK = { x: -20, z: 12, r: 3.3 };
const TREES = [[-6,-8],[-15,6],[-5,14],[2,3],[20,-9],[21,17],[-20,20],[5,-9]];
const inRect = (x, z, r, m = 0) => x > r.x0 - m && x < r.x1 + m && z > r.z0 - m && z < r.z1 + m;

/* ---------- seasons ---------- */
const SEASONS = [
  { name:'Autumn', task:'Raking leaves',      grass:[98,112,46],  mud:[96,70,46],  skyTop:0x5f86b4, skyBot:0xf0d2a6, fog:0xd9c3a0, fd:.014, sun:0xffd7a0, si:2.6, hemiS:0xbfcbe6, hemiG:0x6b5a40, hi:.7,  sunPos:[-34,26,24], tuft:0xe0c878, outer:0x6d6a3a, dist:0xa8622a, exp:1.0 },
  { name:'Winter', task:'Shoveling snow',     grass:[96,108,80],  mud:[84,66,50],  skyTop:0x8fa4bd, skyBot:0xe2e8ef, fog:0xd7dfe8, fd:.019, sun:0xe8f0ff, si:1.7, hemiS:0xe1eaf6, hemiG:0x8a949f, hi:.95, sunPos:[-26,17,26], tuft:0xb4bca5, outer:0xdfe6ee, dist:0xe4eaf0, exp:1.05 },
  { name:'Spring', task:'Seeding & watering', grass:[100,150,54], mud:[74,56,40],  skyTop:0x74aee6, skyBot:0xe9f2e4, fog:0xd2e2da, fd:.013, sun:0xfff0cf, si:2.4, hemiS:0xcfe4ff, hemiG:0x5b6a45, hi:.75, sunPos:[30,30,20],  tuft:0xc4f294, outer:0x5f8a3c, dist:0x86b050, exp:1.0 },
  { name:'Summer', task:'Mowing the lawn',    grass:[58,132,42],  mud:[110,84,56], skyTop:0x3f8fe0, skyBot:0xcfe6f8, fog:0xcfe3f2, fd:.008, sun:0xfff3dc, si:3.2, hemiS:0xd8ecff, hemiG:0x55703a, hi:.8,  sunPos:[22,44,16],  tuft:0xa6e47f, outer:0x4a7f33, dist:0x2d6a30, exp:1.0 }
];
const TOOLS = ['Rake', 'Leaf Blower', 'Snow Shovel', 'Mower', 'Seed Spreader', 'Watering Can'];
const SEASON_TOOLS = [[0,1],[2],[4,5],[3]];

/* ---------- economy ---------- */
const LEAF_PRICE = 1.2, GRASS_UNIT_PRICE = 4.5, SEED_PRICE = 1.5, W = { leaf: .5, grass: .08 };
const UPG = [
  { id:'bag',    name:'Bigger Sack',         desc:'+20 bag capacity (leaves, clippings)',       max:5, base:100, mult:.9 },
  { id:'hand',   name:'Stronger Grip',       desc:'+5 snow carried per shovel load',            max:4, base:90,  mult:.9 },
  { id:'rake',   name:'Wide Rake',           desc:'Wider and longer raking sweep',              max:4, base:80,  mult:.8 },
  { id:'blower', name:'Turbo Blower',        desc:'More range and blowing force',               max:4, base:140, mult:.8 },
  { id:'shovel', name:'Pro Shovel',          desc:'Wider blade and faster scooping',            max:4, base:110, mult:.8 },
  { id:'mower',  name:'Advanced Mower',      desc:'Wider cutting deck',                         max:4, base:160, mult:.8 },
  { id:'seeder', name:'Automatic Spreader',  desc:'Bigger area, faster; level 3 sows as you walk', max:4, base:120, mult:.9 },
  { id:'can',    name:'Big Watering Can',    desc:'More water and a wider spray',               max:4, base:90,  mult:.8 }
];
const upPrice = (u, lv) => Math.round(u.base * (1 + lv * u.mult) / 10) * 10;

/* ---------- game state ---------- */
const G = {
  phase: 'title',               // title | play | roundEnd | fade
  season: 0, round: 0, rounds: 3, year: 1,
  money: 100, debt: 0, bag: { type: null, n: 0 }, hand: 0, seeds: 0, water: 0,
  tool: 0, use: false, working: false, modal: null, time: 0,
  up: {}, hint: '', hintT: 0, incAcc: 0, incT: 0, endTimer: 0,
  snowfall: 0, tl: 0, V0: 1, pileVol: 0, cargo: 0, grow: 1, growAcc: 0, fallAcc: 0,
  uncut: 0, cutTotal: 1, remBare: 0, bareTotal: 1, regrow: [], action: null, locked: false, seedCD: 0, scoopT: 0
};
const lvl = id => G.up[id] || 0;
function stats() {
  return {
    bagCap: 40 + 20 * lvl('bag'), handCap: 10 + 5 * lvl('hand'),
    rakeR: 2.2 + .5 * lvl('rake'), rakeA: 0.9 + .08 * lvl('rake'),
    blowR: 5 + 1.5 * lvl('blower'), blowF: 1 + .3 * lvl('blower'),
    shovR: .9 + .25 * lvl('shovel'), shovRate: 2.4 + .7 * lvl('shovel'),
    mowR: 1 + .25 * lvl('mower'),
    seedR: .9 + .35 * lvl('seeder'), seedCD: .35 / (1 + .35 * lvl('seeder')), seedAuto: lvl('seeder') >= 3,
    canCap: 40 + 20 * lvl('can'), canR: 1 + .3 * lvl('can')
  };
}

/* ---------- renderer / scene ---------- */
const canvas = $('c');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(devicePixelRatio || 1, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.outputColorSpace = THREE.SRGBColorSpace;

const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0xcccccc, 0.012);
const camera = new THREE.PerspectiveCamera(72, innerWidth / innerHeight, 0.05, 600);
camera.rotation.order = 'YXZ';
scene.add(camera);
function resize() {
  renderer.setSize(innerWidth, innerHeight, false);
  camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix();
}
addEventListener('resize', resize); resize();

const hemi = new THREE.HemisphereLight(0xffffff, 0x555544, .7); scene.add(hemi);
const sun = new THREE.DirectionalLight(0xffffff, 2.5);
sun.castShadow = true; sun.shadow.mapSize.set(2048, 2048);
Object.assign(sun.shadow.camera, { left: -38, right: 38, top: 38, bottom: -38, near: 1, far: 150 });
sun.shadow.bias = -0.0004; sun.shadow.normalBias = 0.04;
scene.add(sun, sun.target);

// Sky dome (gradient shader)
const skyMat = new THREE.ShaderMaterial({
  side: THREE.BackSide, depthWrite: false, fog: false,
  uniforms: { top: { value: new THREE.Color() }, bot: { value: new THREE.Color() } },
  vertexShader: 'varying vec3 vP;void main(){vP=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}',
  fragmentShader: 'uniform vec3 top;uniform vec3 bot;varying vec3 vP;void main(){float t=clamp(normalize(vP).y*1.4+0.08,0.,1.);gl_FragColor=vec4(mix(bot,top,pow(t,.7)),1.);\n#include <colorspace_fragment>\n}'
});
const sky = new THREE.Mesh(new THREE.SphereGeometry(420, 24, 12), skyMat); sky.renderOrder = -1; scene.add(sky);

/* ---------- procedural textures & materials ---------- */
function canvasTex(w, h, draw, rep) {
  const c = document.createElement('canvas'); c.width = w; c.height = h; draw(c.getContext('2d'), w, h);
  const t = new THREE.CanvasTexture(c); t.colorSpace = THREE.SRGBColorSpace;
  t.wrapS = t.wrapT = THREE.RepeatWrapping; if (rep) t.repeat.set(rep[0], rep[1]); t.anisotropy = 8; return t;
}
function speckle(g, w, h, base, amp, n) {
  g.fillStyle = base; g.fillRect(0, 0, w, h);
  for (let i = 0; i < n; i++) { const v = (Math.random() - .5) * amp; g.fillStyle = v > 0 ? `rgba(255,255,255,${v / 255})` : `rgba(0,0,0,${-v / 255})`; g.fillRect(Math.random() * w, Math.random() * h, 2, 2); }
}
const std = o => new THREE.MeshStandardMaterial(o);
const mat = (c, r = .6, m = 0) => std({ color: c, roughness: r, metalness: m });
const TEX = {
  wood: canvasTex(128, 128, (g, w, h) => { speckle(g, w, h, '#8a6a46', 60, 900); for (let x = 0; x < w; x += 16) { g.fillStyle = 'rgba(0,0,0,.28)'; g.fillRect(x, 0, 1, h); } }, [1, 1]),
  siding: canvasTex(128, 128, (g, w, h) => { speckle(g, w, h, '#d9d3c4', 24, 500); for (let y = 0; y < h; y += 16) { g.fillStyle = 'rgba(0,0,0,.18)'; g.fillRect(0, y, w, 2); } }, [6, 2]),
  roof: canvasTex(128, 128, (g, w, h) => { speckle(g, w, h, '#4a3f3a', 40, 700); for (let y = 0; y < h; y += 12) { g.fillStyle = 'rgba(0,0,0,.35)'; g.fillRect(0, y, w, 2); } }, [8, 1]),
  bark: canvasTex(64, 128, (g, w, h) => { speckle(g, w, h, '#5b4330', 70, 700); for (let x = 0; x < w; x += 7) { g.fillStyle = 'rgba(0,0,0,.3)'; g.fillRect(x, 0, 2, h); } }, [1, 2])
};
const M = {
  wood: std({ map: TEX.wood, roughness: .85 }), siding: std({ map: TEX.siding, roughness: .9, side: THREE.DoubleSide }),
  roof: std({ map: TEX.roof, roughness: .9 }), bark: std({ map: TEX.bark, roughness: .95 }),
  snow: std({ color: 0xf3f7ff, roughness: .85 }), metal: mat(0x6f7881, .45, .6),
  glass: std({ color: 0x20303f, roughness: .1, metalness: .6, emissive: 0x0a1220 }), white: mat(0xe9e9e4, .7)
};
function box(w, h, d, m, x, y, z, parent = scene, cast = true) {
  const o = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m); o.position.set(x, y, z);
  o.castShadow = cast; o.receiveShadow = true; parent.add(o); return o;
}

/* ---------- cell grid state ---------- */
const type = new Uint8Array(N * N);            // 0 blocked, 1 grass, 2 paved
const bare = new Uint8Array(N * N), seeded = new Uint8Array(N * N), watered = new Uint8Array(N * N);
const snow = new Float32Array(N * N), snowT = new Float32Array(N * N), h = new Float32Array(N * N);
const ao = new Float32Array(N * N), rnd = new Float32Array(N * N);
for (let iz = 0; iz < N; iz++) for (let ix = 0; ix < N; ix++) {
  const i = iz * N + ix, x = cx(ix), z = cz(iz); rnd[i] = Math.random();
  let t = 1;
  if (inRect(x, z, RECT.house, .4) || inRect(x, z, RECT.shed, .5) || inRect(x, z, RECT.trailer, .4)) t = 0;
  else if (x > DRIVE.x0 && x < DRIVE.x1 && z > DRIVE.z0 && z < DRIVE.z1) t = 2;
  type[i] = t; h[i] = .3;
}
// baked ambient occlusion: darker next to buildings and the trailer
for (let iz = 0; iz < N; iz++) for (let ix = 0; ix < N; ix++) {
  let best = 9;
  for (let dz = -3; dz <= 3; dz++) for (let dx = -3; dx <= 3; dx++) {
    const a = ix + dx, b = iz + dz; if (a < 0 || b < 0 || a >= N || b >= N) continue;
    if (type[b * N + a] === 0) best = Math.min(best, Math.hypot(dx, dz));
  }
  ao[iz * N + ix] = 1 - .4 * clamp(1 - (best - .5) / 2.5, 0, 1);
}
function forCircle(px, pz, r, fn) {
  const x0 = Math.max(0, Math.floor(px + HALF - r)), x1 = Math.min(N - 1, Math.floor(px + HALF + r));
  const z0 = Math.max(0, Math.floor(pz + HALF - r)), z1 = Math.min(N - 1, Math.floor(pz + HALF + r));
  outer: for (let iz = z0; iz <= z1; iz++) for (let ix = x0; ix <= x1; ix++) {
    const dx = cx(ix) - px, dz = cz(iz) - pz;
    if (dx * dx + dz * dz <= r * r) { if (fn(iz * N + ix, dx, dz) === false) break outer; }
  }
}
const cellAt = (x, z) => { const ix = Math.floor(x + HALF), iz = Math.floor(z + HALF); return (ix < 0 || iz < 0 || ix >= N || iz >= N) ? -1 : iz * N + ix; };

/* ---------- ground: canvas texture + displaced mesh (snow depth) ---------- */
const gcan = document.createElement('canvas'); gcan.width = gcan.height = N * 8;
const gctx = gcan.getContext('2d');
const gtex = new THREE.CanvasTexture(gcan); gtex.colorSpace = THREE.SRGBColorSpace; gtex.anisotropy = 8;
const gGeo = new THREE.PlaneGeometry(N, N, N, N); gGeo.rotateX(-Math.PI / 2);
const ground = new THREE.Mesh(gGeo, std({ map: gtex, roughness: .97 }));
ground.receiveShadow = true; scene.add(ground);
const outer = new THREE.Mesh(new THREE.PlaneGeometry(900, 900).rotateX(-Math.PI / 2), std({ color: 0x4a7f33, roughness: 1 }));
outer.position.y = -.04; outer.receiveShadow = true; scene.add(outer);

const dirty = new Set(); let snowDirty = false;
const mark = i => dirty.add(i);
const markAll = () => { for (let i = 0; i < N * N; i++) dirty.add(i); snowDirty = true; };
const frac = v => v - Math.floor(v);
function drawCell(i) {
  const ix = i % N, iz = (i / N) | 0, S = SEASONS[G.season], t = type[i], r = rnd[i];
  let c;
  if (t === 0) c = [64, 60, 56];
  else if (t === 2) { const v = 112 + r * 22; c = [v, v, v - 3]; }
  else if (bare[i]) {
    const b = watered[i] ? [48, 35, 26] : seeded[i] ? [86, 62, 42] : S.mud;
    c = [b[0] + r * 12, b[1] + r * 9, b[2] + r * 7];
  } else {
    const g = S.grass, cut = (G.season === 3 && h[i] < .3) ? (iz % 2 ? 10 : -8) : 0, v = (r - .5) * 20 + cut;
    c = [g[0] + v * .6, g[1] + v, g[2] + v * .4];
  }
  const a = ao[i]; c = [c[0] * a, c[1] * a, c[2] * a];
  const s = snow[i];
  if (s > .01 && t !== 0) { const k = Math.min(1, s * 1.5 + .15); c = [c[0] + (236 - c[0]) * k, c[1] + (240 - c[1]) * k, c[2] + (248 - c[2]) * k]; }
  const X = ix * 8, Y = iz * 8;
  gctx.fillStyle = `rgb(${c[0] | 0},${c[1] | 0},${c[2] | 0})`; gctx.fillRect(X, Y, 8, 8);
  for (let k = 0; k < 4; k++) {                       // deterministic grain
    const hh = Math.sin(i * 12.9898 + k * 78.233) * 43758.5453, gx = (frac(hh) * 7) | 0, gy = (frac(hh * 7.1) * 7) | 0, d = (frac(hh * 3.3) - .5) * 38;
    gctx.fillStyle = `rgb(${clamp(c[0] + d, 0, 255) | 0},${clamp(c[1] + d, 0, 255) | 0},${clamp(c[2] + d, 0, 255) | 0})`; gctx.fillRect(X + gx, Y + gy, 2, 1);
  }
}
function updateSnowMesh() {
  const pos = gGeo.attributes.position;
  for (let j = 0; j <= N; j++) for (let i = 0; i <= N; i++) {
    let s = 0, c = 0;
    for (let dj = -1; dj <= 0; dj++) for (let di = -1; di <= 0; di++) {
      const ix = i + di, iz = j + dj; if (ix < 0 || iz < 0 || ix >= N || iz >= N) continue; s += snow[iz * N + ix]; c++;
    }
    pos.setY(j * (N + 1) + i, c ? s / c * .3 : 0);
  }
  pos.needsUpdate = true; gGeo.computeVertexNormals();
}

/* ---------- instanced grass tufts ---------- */
const TPC = 5, TMAX = N * N * TPC;
function bladeGeo() {
  const pos = [], col = [], nor = [], w = .07;
  for (let b = 0; b < 3; b++) {
    const a = b * Math.PI / 3, c = Math.cos(a), s = Math.sin(a);
    pos.push(-w * c, 0, -w * s, w * c, 0, w * s, .03 * c, 1, .03 * s);
    col.push(.26, .4, .13, .26, .4, .13, .72, .92, .4); nor.push(0, 1, 0, 0, 1, 0, 0, 1, 0);
  }
  const g = new THREE.BufferGeometry();
  g.setAttribute('position', new THREE.Float32BufferAttribute(pos, 3));
  g.setAttribute('color', new THREE.Float32BufferAttribute(col, 3));
  g.setAttribute('normal', new THREE.Float32BufferAttribute(nor, 3)); return g;
}
const tMat = std({ vertexColors: true, side: THREE.DoubleSide, roughness: .9, color: 0xffffff });
const tufts = new THREE.InstancedMesh(bladeGeo(), tMat, TMAX); tufts.frustumCulled = false; tufts.receiveShadow = true;
const tOff = new Float32Array(TMAX * 4), tmpC = new THREE.Color();
for (let i = 0; i < N * N; i++) for (let k = 0; k < TPC; k++) {
  const o = (i * TPC + k) * 4; tOff[o] = rr(-.45, .45); tOff[o + 1] = rr(-.45, .45); tOff[o + 2] = rr(0, 6.28); tOff[o + 3] = rr(.8, 1.35);
  const v = rr(.8, 1.05); tmpC.setRGB(v, v, v * rr(.9, 1)); tufts.setColorAt(i * TPC + k, tmpC);
}
scene.add(tufts);
const dummy = new THREE.Object3D();
function updateTufts(i) {
  const ix = i % N, iz = (i / N) | 0, x0 = cx(ix), z0 = cz(iz);
  const show = type[i] === 1 && !bare[i] && snow[i] < .22;
  let hh = 0;
  if (show) { const hv = h[i]; hh = .07 + .5 * (hv > .5 ? (.3 + .7 * G.grow) : hv); }
  for (let k = 0; k < TPC; k++) {
    const o = (i * TPC + k) * 4;
    dummy.position.set(x0 + tOff[o], snow[i] * .3, z0 + tOff[o + 1]);
    dummy.rotation.set(0, tOff[o + 2], 0);
    if (hh > 0) dummy.scale.set(tOff[o + 3], hh * tOff[o + 3], tOff[o + 3]); else dummy.scale.set(0, 0, 0);
    dummy.updateMatrix(); tufts.setMatrixAt(i * TPC + k, dummy.matrix);
  }
}
function refreshAllTufts() { for (let i = 0; i < N * N; i++) updateTufts(i); tufts.instanceMatrix.needsUpdate = true; }
function flush() {
  if (dirty.size) { for (const i of dirty) { drawCell(i); updateTufts(i); } dirty.clear(); gtex.needsUpdate = true; tufts.instanceMatrix.needsUpdate = true; }
}

