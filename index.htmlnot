/* ---------- trees ---------- */
const treeObjs = [], AUTUMN_COLORS = [0xd9822b, 0xc0392b, 0xe0b030, 0xb5651d, 0xcf6a1f, 0xd19a1f, 0xa8442a, 0xdca02a];
function jitterGeo(geo, seed, amp) {
  const p = geo.attributes.position;
  for (let i = 0; i < p.count; i++) {
    const x = p.getX(i), y = p.getY(i), z = p.getZ(i), n = Math.sin(x * 2.3 + seed) * Math.cos(z * 2.1 + seed * 1.7) * Math.sin(y * 1.9 + seed * .6);
    const s = 1 + amp * n; p.setXYZ(i, x * s, y * s, z * s);
  } geo.computeVertexNormals(); return geo;
}
TREES.forEach(([x, z], ti) => {
  const g = new THREE.Group(); g.position.set(x, 0, z); scene.add(g);
  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(.22, .42, 4.8, 10), M.bark); trunk.position.y = 2.4; trunk.castShadow = true; g.add(trunk);
  const fm = std({ color: 0x2f7d32, roughness: .85 }), fol = new THREE.Group(); fol.position.y = 5.6; g.add(fol);
  for (let k = 0; k < 6; k++) {
    const r = rr(1.5, 2.3), b = new THREE.Mesh(jitterGeo(new THREE.IcosahedronGeometry(r, 2), ti * 7 + k, .16), fm);
    b.position.set(rr(-1.7, 1.7), rr(-.4, 1.8), rr(-1.7, 1.7)); b.castShadow = true; b.receiveShadow = true; fol.add(b);
  }
  const branches = new THREE.Group(); branches.position.y = 4.3; g.add(branches);
  const caps = [];
  for (let k = 0; k < 6; k++) {
    const len = rr(2, 3), geo = new THREE.CylinderGeometry(.03, .09, len, 6); geo.translate(0, len / 2, 0);
    const br = new THREE.Mesh(geo, M.bark); br.rotation.set(0, k * 1.05, rr(.7, 1.1)); br.rotation.order = 'YZX'; br.castShadow = true; branches.add(br);
    const cap = new THREE.Mesh(new THREE.SphereGeometry(.3, 8, 6), M.snow); cap.scale.set(1, .35, 1); cap.position.set(0, len * .7, .08); br.add(cap); caps.push(cap);
  }
  const mound = new THREE.Mesh(new THREE.SphereGeometry(1, 12, 6), M.snow); mound.scale.set(1.3, .1, 1.3); mound.position.y = .02; g.add(mound);
  treeObjs.push({ g, fm, fol, branches, caps, mound, autumn: AUTUMN_COLORS[ti % AUTUMN_COLORS.length] });
});
// distant forest ring (cheap atmosphere)
const distMat = std({ color: 0x2d6a30, roughness: 1 });
const distTrees = new THREE.InstancedMesh(jitterGeo(new THREE.IcosahedronGeometry(1, 1), 3, .2), distMat, 70);
{
  const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), s = new THREE.Vector3();
  for (let i = 0; i < 70; i++) {
    const a = Math.random() * Math.PI * 2, d = rr(52, 110), sc = rr(5, 9);
    s.set(sc, sc * rr(1, 1.5), sc); m4.compose(new THREE.Vector3(Math.cos(a) * d, sc * 1.1, Math.sin(a) * d), q, s); distTrees.setMatrixAt(i, m4);
  } scene.add(distTrees);
}

/* ---------- falling snow particles ---------- */
const SNOWN = 1800, snowPos = new Float32Array(SNOWN * 3);
for (let i = 0; i < SNOWN; i++) { snowPos[i * 3] = rr(-22, 22); snowPos[i * 3 + 1] = rr(0, 18); snowPos[i * 3 + 2] = rr(-22, 22); }
const snowGeo = new THREE.BufferGeometry(); snowGeo.setAttribute('position', new THREE.BufferAttribute(snowPos, 3));
