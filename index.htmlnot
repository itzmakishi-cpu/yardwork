// fence (instanced pickets + rails + posts)
{
  const mats = [], posts = [], m4 = new THREE.Matrix4();
  const line = (x0, z0, x1, z1, rotY, skip) => {
    const len = Math.hypot(x1 - x0, z1 - z0), n = Math.floor(len / .2);
    for (let k = 0; k <= n; k++) {
      const t = k / n, x = x0 + (x1 - x0) * t, z = z0 + (z1 - z0) * t; if (skip && skip(x, z)) continue;
      m4.makeRotationY(rotY); m4.setPosition(x, .675 + (Math.sin(k * 3.7) * .02), z); mats.push(m4.clone());
    }
    for (let d = 0; d <= len; d += 3) { const t = d / len; m4.makeRotationY(rotY); m4.setPosition(x0 + (x1 - x0) * t, .8, z0 + (z1 - z0) * t); posts.push(m4.clone()); }
    const mx = (x0 + x1) / 2, mz = (z0 + z1) / 2;
    for (const y of [.35, 1.0]) { const r = new THREE.Mesh(rotY === 0 ? new THREE.BoxGeometry(len, .07, .05) : new THREE.BoxGeometry(.05, .07, len), M.wood); r.position.set(mx, y, mz); r.castShadow = true; scene.add(r); }
  };
  const E = HALF - .02;
  line(-E, -E, E, -E, 0); line(-E, E, E, E, 0, (x) => x > 7.6 && x < 13.4);
  line(-E, -E, -E, E, Math.PI / 2); line(E, -E, E, E, Math.PI / 2);
  const pk = new THREE.InstancedMesh(new THREE.BoxGeometry(.11, 1.35, .03), M.wood, mats.length);
  mats.forEach((m, i) => pk.setMatrixAt(i, m)); pk.castShadow = true; pk.receiveShadow = true; scene.add(pk);
  const ps = new THREE.InstancedMesh(new THREE.BoxGeometry(.14, 1.6, .14), M.wood, posts.length);
  posts.forEach((m, i) => ps.setMatrixAt(i, m)); ps.castShadow = true; scene.add(ps);
}
// snow-pile marker (winter)
const markerG = new THREE.Group(); scene.add(markerG);
{
  const ring = new THREE.Mesh(new THREE.RingGeometry(MARK.r - .25, MARK.r, 48), std({ color: 0xff7a1a, roughness: .7, side: THREE.DoubleSide }));
  ring.rotation.x = -Math.PI / 2; ring.position.set(MARK.x, .06, MARK.z); markerG.add(ring);
  for (let k = 0; k < 8; k++) {
    const a = k / 8 * Math.PI * 2, pole = box(.1, 1.8, .1, mat(k % 2 ? 0xff7a1a : 0xf2f2f2, .5), MARK.x + Math.cos(a) * MARK.r, .9, MARK.z + Math.sin(a) * MARK.r, markerG);
  }
  const flag = box(.9, .5, .04, mat(0xff7a1a, .6), MARK.x + MARK.r + .5, 1.55, MARK.z, markerG);
}
const pile = new THREE.Mesh(new THREE.SphereGeometry(1, 20, 12), M.snow); pile.castShadow = true; pile.receiveShadow = true;
