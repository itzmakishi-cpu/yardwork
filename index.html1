const DECN = 380, decor = new THREE.InstancedMesh(new THREE.PlaneGeometry(.3, .2), std({ roughness: .9, side: THREE.DoubleSide }), DECN);
decor.frustumCulled = false; scene.add(decor);
const dAnch = [], dPh = [], dSp = [];
for (let i = 0; i < DECN; i++) { const a = outerTrees[i % outerTrees.length]; dAnch.push([a[0] + rr(-2.5, 2.5), a[1] + rr(-2.5, 2.5)]); dPh.push(Math.random()); dSp.push(rr(.05, .11)); }
function setDecorColors() {
  const cols = G.season === 2 ? [0xffd1e0, 0xffffff, 0xf7a8c4] : [0xd9822b, 0xc0392b, 0xe0b030, 0xb5651d, 0xa8442a, 0xcf9a2a];
  for (let i = 0; i < DECN; i++) { tmpC.setHex(cols[i % cols.length]); tmpC.multiplyScalar(rr(.85, 1.1)); decor.setColorAt(i, tmpC); } decor.instanceColor.needsUpdate = true;
}
function updateDecor(t) {
  decor.visible = G.season === 0 || G.season === 2; if (!decor.visible) return;
  const wind = SEASONS[G.season].wind;
  for (let i = 0; i < DECN; i++) {
    const u = (t * dSp[i] + dPh[i]) % 1, rest = u > .88, y = rest ? .03 : 8 * (1 - u / .88) + .03;
    dummy.position.set(dAnch[i][0] + Math.sin(t * .9 + dPh[i] * 20) * 1.6 + u * 4 * wind, y, dAnch[i][1] + Math.cos(t * .7 + dPh[i] * 17) * 1.4);
    dummy.rotation.set(-Math.PI / 2 + (rest ? 0 : Math.sin(t * 3 + i) * .9), 0, t * 2 + i); const sc = rest ? clamp(1 - (u - .88) / .12, 0, 1) : 1; dummy.scale.set(sc, sc, sc); dummy.updateMatrix(); decor.setMatrixAt(i, dummy.matrix);
  } decor.instanceMatrix.needsUpdate = true;
}

