/* ---------- audio (procedural Web Audio) ---------- */
const AU = { ctx: null, mute: false };
function initAudio() {
  if (AU.ctx) return;
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)(); AU.ctx = ctx; AU.master = ctx.createGain(); AU.master.gain.value = .6; AU.master.connect(ctx.destination);
    const len = ctx.sampleRate * 2, buf = ctx.createBuffer(1, len, ctx.sampleRate), d = buf.getChannelData(0); for (let i = 0; i < len; i++) d[i] = Math.random() * 2 - 1; AU.noise = buf;
    const loop = (t, f, q) => { const s = ctx.createBufferSource(); s.buffer = buf; s.loop = true; const fl = ctx.createBiquadFilter(); fl.type = t; fl.frequency.value = f; fl.Q.value = q; const g = ctx.createGain(); g.gain.value = 0; s.connect(fl); fl.connect(g); g.connect(AU.master); s.start(); return { fl, g }; };
    AU.blow = loop('bandpass', 650, .8); AU.rake = loop('highpass', 3200, .7); AU.mow = loop('lowpass', 520, 1); AU.water = loop('highpass', 2800, .5); AU.wind = loop('bandpass', 400, .5);
    AU.osc = ctx.createOscillator(); AU.osc.type = 'sawtooth'; AU.osc.frequency.value = 58; const of = ctx.createBiquadFilter(); of.type = 'lowpass'; of.frequency.value = 380; AU.og = ctx.createGain(); AU.og.gain.value = 0; AU.osc.connect(of); of.connect(AU.og); AU.og.connect(AU.master); AU.osc.start();
  } catch (e) { console.warn('Audio unavailable', e); AU.ctx = null; }
}
const setLoop = (l, v) => { if (AU.ctx && l) l.g.gain.setTargetAtTime(AU.mute ? 0 : v, AU.ctx.currentTime, .08); };
function burst(f, dur, vol, type = 'bandpass') {
  if (!AU.ctx || AU.mute) return; const c = AU.ctx, s = c.createBufferSource(); s.buffer = AU.noise; const fl = c.createBiquadFilter(); fl.type = type; fl.frequency.value = f; const g = c.createGain(), t = c.currentTime;
  g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + dur); s.connect(fl); fl.connect(g); g.connect(AU.master); s.start(t, Math.random()); s.stop(t + dur);
}
function tone(f, dur, vol, delay = 0, type = 'triangle') {
  if (!AU.ctx || AU.mute) return; const c = AU.ctx, o = c.createOscillator(), g = c.createGain(), t = c.currentTime + delay;
  o.type = type; o.frequency.value = f; g.gain.setValueAtTime(vol, t); g.gain.exponentialRampToValueAtTime(.001, t + dur); o.connect(g); g.connect(AU.master); o.start(t); o.stop(t + dur);
}
const coin = () => { tone(880, .18, .18); tone(1320, .3, .16, .08); };

/* ---------- HUD helpers ---------- */
let hotSlots = [];
function ownedTools() { return [0, 1, 2, 3, 4, 5, 6, 7].filter(owns); }
function buildHotbar() {
  const hb = $('hotbar'); hb.innerHTML = ''; hotSlots = [];
  ownedTools().forEach((t, i) => { const d = document.createElement('div'); d.className = 'slot'; d.innerHTML = `<div class="k num">${i + 1}</div><div class="n num">${TOOLNAME[t]}</div>`; hb.appendChild(d); hotSlots.push([t, d]); });
}
function toast(msg, kind = '') { const d = document.createElement('div'); d.className = 'toast ' + kind; d.textContent = msg; $('toasts').appendChild(d); setTimeout(() => d.remove(), 3700); }
function banner(t, s) { const b = $('banner'); $('bannerT').textContent = t; $('bannerS').textContent = s; b.classList.remove('show'); void b.offsetWidth; b.classList.add('show'); }
function fadeTo(cb) { const f = $('fade'); f.classList.add('on'); setTimeout(() => { cb(); setTimeout(() => f.classList.remove('on'), 200); }, 650); }
function hint(msg) { G.hint = msg; G.hintT = 2; }
function income(amount) {
  if (G.debt > 0) { const rep = Math.min(G.debt, amount * .5); G.debt -= rep; amount -= rep; G.incRep = (G.incRep || 0) + rep; }
  G.money += amount; G.incAcc += amount; G.incT = 1.1;
}
const countBare = () => { let c = 0; for (let i = 0; i < N * N; i++) if (type[i] === 1 && bare[i]) c++; return c; };

/* ---------- season visuals ---------- */
function applySeasonVisuals() {
  const S = SEASONS[G.season], winter = G.season === 1;
  skyMat.uniforms.top.value.setHex(S.skyTop); skyMat.uniforms.bot.value.setHex(S.skyBot); skyMat.uniforms.sunDir.value.set(...S.sunPos);
  scene.fog.color.setHex(S.fog); scene.fog.density = S.fd; hemi.color.setHex(S.hemiS); hemi.groundColor.setHex(S.hemiG);
  sun.color.setHex(S.sun); outerG.material.color.setHex(S.outer); tMat.color.setHex(S.tuft); distMat.color.setHex(S.dist); windS.value = S.wind;
  clouds.forEach(c => { c.material.color.setHex(S.cloud); c.material.opacity = S.cloudA; });
  treeObjs.forEach(t => {
    t.fol.visible = !winter; t.branches.visible = G.season !== 3;
    if (G.season === 0) { t.fm.color.setHex(t.autumn); t.fol.scale.setScalar(.95); } else if (G.season === 2) { t.fm.color.setHex(0xa8d65f); t.fol.scale.setScalar(.55); t.fol.visible = true; } else if (G.season === 3) { t.fm.color.setHex(0x2f7d32); t.fol.scale.setScalar(1); }
    t.caps.forEach(c => c.visible = winter); t.mound.visible = winter;
  });
  hedgeMat.color.setHex(G.season === 0 ? 0x6b7a2d : G.season === 1 ? 0x4a5a45 : G.season === 2 ? 0x4f9a3d : 0x2d6a30); flowers.visible = G.season === 2 || G.season === 3;
  snowShells.forEach(s => s.visible = winter); trailerSnow.visible = winter; markerG.visible = winter; cargo.visible = G.cargo > 0 && !winter;
  for (let i = 0; i < N * N; i++) if (type[i] === 1 && !bare[i] && G.season !== 3) hgt[i] = .3;
  setDecorColors(); markAll();
}

/* ---------- round / season flow ---------- */
function setCargo(v, t) {
  G.cargo = v; cargo.visible = v > 0 && G.season !== 1; const sy = .12 + Math.min(.75, v * .0035); cargo.scale.set(1.05, sy, 2.5 * Math.min(1, .4 + v * .01)); cargo.position.y = .85 + sy * .4;
  if (t) cargoMat.color.setHex(t === 'leaf' ? 0xb4682a : 0x4f9a3a);
}
function bestTool() { for (const t of SEASON_PREF[G.season]) if (owns(t)) return t; return 0; }
function beginSeason(s) {
  G.season = s; G.round = 0; G.rounds = [rint(3, 4), rint(5, 7), 1, rint(3, 4)][s]; G.load = { type: null, n: 0 };
  applySeasonVisuals(); G.tool = bestTool(); nextRound();
}
function nextRound() { G.round++; if (G.round > G.rounds) { const ns = (G.season + 1) % 4; if (ns === 0) G.year++; beginSeason(ns); return; } startRound(); }
function startRound() {
  const S = SEASONS[G.season]; G.phase = 'play'; setCargo(0); snowPts.visible = G.season === 1; G.tool = bestTool();
  banner(`${S.name} · Year ${G.year}`, `${S.task}, round ${G.round} of ${G.rounds}`);
  if (G.season === 0) {
    ls.fill(0); L.quota = 110 + 30 * (G.round - 1); L.spawned = 0; L.dumped = 0; L.acc = 0;
    for (let i = 0; i < MAXL; i++) { dummy.scale.set(0, 0, 0); dummy.updateMatrix(); leafMesh.setMatrixAt(i, dummy.matrix); }
    if (G.round === 1) toast('Grab leaves by hand and carry them to the trailer', '');
  } else if (G.season === 1) {
    genSnow(); G.snowfall = 5; G.tl = Math.max(180, 260 - 10 * (G.round - 1)); G.fallAcc = 0; if (G.round === 1) { G.pileVol = 0; updatePile(); }
  } else if (G.season === 2) {
    pile.scale.set(.01, .01, .01); snow.fill(0); snowT.fill(0); G.pileVol = 0; addDrySpots(3, 2.6); G.bareTotal = G.remBare = countBare(); G.regrow = [];
    for (let i = 0; i < N * N; i++) { seeded[i] = 0; watered[i] = 0; } if (owns(7)) G.water = stats().canCap; else G.water = 0; markAll(); G.seeds = 0;
    if (G.remBare === 0) { completeRound('The lawn is perfect. Nothing to reseed.'); return; }
    toast('Bare patches need seed. Gustav sells it, and lends cash if you are short.');
  } else {
    let c = 0; for (let i = 0; i < N * N; i++) if (type[i] === 1 && !bare[i]) { hgt[i] = 1; c++; }
    G.uncut = G.cutTotal = Math.max(1, c); G.grow = 0; G.growAcc = 0; markAll();
  }
}
function completeRound(msg) { G.phase = 'roundEnd'; G.endTimer = 2.6; toast(msg, 'good'); tone(660, .25, .15); tone(990, .4, .15, .12); if (G.round >= G.rounds) toast(`${SEASONS[G.season].name} is done`, 'good'); }
function pickCenter(avoidMark) { for (let k = 0; k < 40; k++) { const x = rr(-21, 21), z = rr(-13, 21), c = cellAt(x, z); if (c >= 0 && type[c] !== 0 && (!avoidMark || Math.hypot(x - MARK.x, z - MARK.z) > 7)) return { x, z }; } return { x: 0, z: 10 }; }
function genSnow() {
  snowT.fill(0); snow.fill(0); const blobs = [{ x: rr(9.5, 11.5), z: rr(-6, 16), r: rr(2.2, 3) }];
  const k = Math.min(5, 2 + G.round); for (let i = 0; i < k; i++) { const c = pickCenter(true); blobs.push({ x: c.x, z: c.z, r: rr(2, 3) }); }
  for (const b of blobs) forCircle(b.x, b.z, b.r, (c, dx, dz) => { if (type[c] === 0) return; const d = Math.hypot(dx, dz) / b.r, v = (1 - d * d * .6) * rr(.7, 1); snowT[c] = Math.max(snowT[c], Math.min(1, v)); });
  let V = 0; for (let i = 0; i < N * N; i++) V += snowT[i]; G.V0 = Math.max(1, V);
}
function addDrySpots(b, r) { for (let k = 0; k < b; k++) { const c = pickCenter(false); forCircle(c.x, c.z, r, (i, dx, dz) => { if (type[i] === 1 && Math.random() < 1 - Math.hypot(dx, dz) / r * .5) bare[i] = 1; }); } }
function rotUnderSnow() {
  let n = 0;
  for (let i = 0; i < N * N; i++) if (snowT[i] > 0 && snow[i] > .04 && type[i] === 1) {
    if (!bare[i]) { bare[i] = 1; n++; } const ix = i % N, iz = (i / N) | 0;
    for (let dz = -1; dz <= 1; dz++) for (let dx = -1; dx <= 1; dx++) { const a = ix + dx, b = iz + dz; if (a < 0 || b < 0 || a >= N || b >= N) continue; const j = b * N + a; if (type[j] === 1 && !bare[j] && Math.random() < .55) { bare[j] = 1; n++; } }
  } return n;
}
function updatePile() { const v = G.pileVol, r = Math.min(MARK.r - .4, .4 + Math.sqrt(v) * .2), hh = Math.min(2.2, .15 + Math.sqrt(v) * .12); pile.scale.set(r, hh, r); }

/* ---------- Gustav's dialog, shop & bank ---------- */
const modalEl = $('modal'), modalCard = $('modalCard'); let shopTab = 'talk';
function lockPointer() { try { const p = canvas.requestPointerLock(); if (p && p.catch) p.catch(() => showPause()); } catch (e) { showPause(); } }
function showPause() { if (G.phase !== 'title' && !G.modal) $('pause').classList.add('show'); }
function openModal(kind) { G.modal = kind; G.use = false; modalEl.classList.add('show'); $('pause').classList.remove('show'); if (document.pointerLockElement) document.exitPointerLock(); renderModal(); }
function closeModal() { G.modal = null; modalEl.classList.remove('show'); lockPointer(); }
const pips = (l, m) => { let s = ''; for (let i = 0; i < m; i++) s += `<i class="${i < l ? 'f' : ''}"></i>`; return s; };
function advice() {
  const s = G.season;
  if (s === 0) return !G.own.rake ? "Leaves first. Pick them up by hand and walk them to the trailer. A sack and a rake will save your back." : G.own.blower ? "Blow them toward the trailer, anything that lands in it counts. Rake the rest into the sack." : "The rake pulls leaves toward you. A blower flings them straight into the trailer.";
  if (s === 1) return !G.own.shovel ? "Snow by hand is slow. Scoop it, carry it to the orange marker. A shovel carries twice as much." : "Shovel it, dump it on the marker pile. Don't let it sit, the lawn rots under it.";
  if (s === 2) return "Seed only goes on bare soil, then water it. I sell seed in the Seeds tab, and I can front you the cash.";
  return !G.own.mower ? "Nail scissors? You're brave. A lawn mower pays for itself, trust me." : "Mow in lines, empty the grass bag at the trailer. Clippings sell by the unit.";
}
const TIPS = ["A sack stays where you leave it. Grab it with F and drag it behind you, or buy a wheelbarrow.", "Wind makes the grass sway and your leaves drift. Blowers beat the breeze.", "Half of every sale goes to your debt until it's paid. I'm no bank, but I do keep count.", "Walk out the gate sometime. The street is nice in every season.", "Upgrades only for tools you own. I don't sell air."];
function say(s) { G.speech = s; }
function renderModal() {
  const debtLine = G.debt > 0 ? `<span style="color:var(--bad)">Debt ${money(G.debt)}</span>` : '';
  const tabs = [['talk', 'Talk'], ['up', 'Upgrades'], ['bank', 'Loans']]; if (G.season === 2) tabs.push(['seed', 'Seeds']); if (!tabs.find(t => t[0] === shopTab)) shopTab = 'talk';
  let body = '';
  if (shopTab === 'talk') body = `<div class="btns"><button class="ghost" data-act="adv">What should I do now?</button><button class="ghost" data-act="tip">Any tips?</button><button class="ghost" data-act="who">Who are you?</button></div>`;
  else if (shopTab === 'up') body = UPG.map(u => { const has = !u.need || G.own[u.need], l = lvl(u.id), mx = l >= u.max, p = upPrice(u, l); return `<div class="row"><div><b>${u.name}</b><span>${has ? u.desc : 'Buy the item from my shelves first'}</span></div><div class="pips">${pips(l, u.max)}</div><button data-act="buy" data-arg="${u.id}" ${!has || mx || G.money < p ? 'disabled' : ''}>${mx ? 'Maxed' : money(p)}</button></div>`; }).join('');
  else if (shopTab === 'bank') body = `<div class="bank"><div class="line"><span>Cash</span><b class="num">${money(G.money)}</b></div><div class="line"><span>Debt</span><b class="num" style="color:${G.debt > 0 ? 'var(--bad)' : 'inherit'}">${money(G.debt)}</b></div><p style="margin:0">A 10% fee on every loan, and half of everything you sell goes to me until it's repaid. My limit is $3,000 of debt.</p>
      <div class="btns">${[100, 250, 500, 1000].map(a => `<button data-act="loan" data-arg="${a}" ${G.debt + a * 1.1 > 3000 ? 'disabled' : ''}>Borrow ${money(a)} (repay ${money(a * 1.1)})</button>`).join('')}</div>
      <div class="btns"><button class="ghost" data-act="repay" data-arg="100" ${G.debt <= 0 || G.money < 1 ? 'disabled' : ''}>Repay $100</button><button class="ghost" data-act="repay" data-arg="all" ${G.debt <= 0 || G.money < 1 ? 'disabled' : ''}>Repay as much as possible</button></div></div>`;
  else { const need = Math.max(0, G.remBare - G.seeds), cost = need * SEED_PRICE, short = cost - G.money, afford = Math.floor(G.money / SEED_PRICE);
    body = `<p>${G.remBare} bare patches left, ${G.seeds} seeds in your pocket. Missing ${need} seeds at ${money(SEED_PRICE)} each: ${money(cost)}.</p><div class="btns" style="margin-top:12px">` +
      (need === 0 ? '' : short <= 0 ? `<button data-act="seedAll">Buy ${need} seeds, ${money(cost)}</button>` : `<button data-act="seedLoan" data-arg="${Math.ceil(short / 10) * 10}">Borrow ${money(Math.ceil(short / 10) * 10)} and buy ${need} seeds</button>` + (afford > 0 ? `<button class="ghost" data-act="seedSome" data-arg="${afford}">Buy ${afford} seeds with my cash</button>` : '')) + `<button class="ghost" data-act="seeds" ${G.money < SEED_PRICE * 20 ? 'disabled' : ''}>+20 seeds, ${money(SEED_PRICE * 20)}</button></div>`; }
  modalCard.innerHTML = `<div class="head"><h2 class="num">Gustav's Hardware</h2><div class="num" style="font-size:24px">${money(G.money)} ${debtLine}</div></div>
    <div class="speech"><b>Gustav:</b> ${G.speech || 'Welcome in!'}</div><div class="tabs">${tabs.map(t => `<button data-act="tab" data-arg="${t[0]}" class="${shopTab === t[0] ? 'on' : ''}">${t[1]}</button>`).join('')}</div>${body}
    <div class="btns" style="margin-top:16px"><button data-act="close">Back to the shop</button></div>`;
}
modalCard.addEventListener('click', e => {
  const b = e.target.closest('[data-act]'); if (!b || b.disabled) return; const a = b.dataset.act, arg = b.dataset.arg;
  if (a === 'close') closeModal();
  else if (a === 'tab') { shopTab = arg; renderModal(); }
  else if (a === 'adv') { say(advice()); renderModal(); } else if (a === 'tip') { say(TIPS[rint(0, TIPS.length - 1)]); renderModal(); } else if (a === 'who') { say("Gustav. Forty years behind this counter. I sell tools, I lend a little cash, and I know a bad lawn when I see one."); renderModal(); }
  else if (a === 'buy') { const u = UPG.find(x => x.id === arg), l = lvl(arg), p = upPrice(u, l); if (l < u.max && G.money >= p) { G.money -= p; G.up[arg] = l + 1; coin(); say('Good choice. That will treat you well.'); if (arg === 'can') G.water = stats().canCap; renderModal(); } }
  else if (a === 'seeds') { if (G.money >= SEED_PRICE * 20) { G.money -= SEED_PRICE * 20; G.seeds += 20; coin(); renderModal(); } }
  else if (a === 'loan') { const v = +arg; G.money += v; G.debt += Math.round(v * 1.1); coin(); say("Pay me back when you can. I take half of every sale until then."); renderModal(); }
  else if (a === 'repay') { const v = arg === 'all' ? Math.min(G.debt, G.money) : Math.min(+arg, G.debt, G.money); G.money -= v; G.debt -= v; say('Thank you kindly.'); renderModal(); }
  else if (a === 'seedAll') { const n = Math.max(0, G.remBare - G.seeds); G.money -= n * SEED_PRICE; G.seeds += n; coin(); say('There you go. Sow it, then water it.'); renderModal(); }
  else if (a === 'seedLoan') { const v = +arg, n = Math.max(0, G.remBare - G.seeds); G.money += v; G.debt += Math.round(v * 1.1); G.money -= n * SEED_PRICE; G.seeds += n; coin(); say("Bad winter, huh? Here's the cash. Half your sales come back to me."); renderModal(); }
  else if (a === 'seedSome') { const n = +arg; G.money -= n * SEED_PRICE; G.seeds += n; coin(); renderModal(); }
});
function buyShelf(id) {
  const it = ITEMS.find(i => i.id === id); if (!it || G.own[id]) return;
  if (G.money < it.price) { toast(`${it.name} costs ${money(it.price)}. Ask Gustav for a loan.`, 'bad'); return; }
  G.money -= it.price; G.own[id] = 1; coin(); const si = shelfItems[id]; si.root.visible = false; si.lb.visible = false; if (si.rect) si.rect.off = true;
  toast(`Bought: ${it.name}`, 'good');
  if (it.cont) spawnContainer(it.cont); else { buildHotbar(); G.tool = it.tool; }
}

/* ---------- player, collisions ---------- */
const P = { x: 2, z: 10, yaw: 0, pitch: -.1, vx: 0, vz: 0, bob: 0, speed: 0 };
const keys = {};
function walkable(x, z) {
  if (Math.abs(x) <= HALF - .7 && Math.abs(z) <= HALF - .7) return true;                         // yard
  if (z >= 25.2 && z <= 40.4 && Math.abs(x) <= 57) return true;                                  // sidewalk + road
  return G.gateOpen && z >= 22.5 && z <= 26 && x >= 8.3 && x <= 12.7;                            // open gate
}
function collide(px, pz, r) {
  for (const R of OBST) {
    if (R.off) continue; const qx = clamp(px, R.x0, R.x1), qz = clamp(pz, R.z0, R.z1), dx = px - qx, dz = pz - qz, d2 = dx * dx + dz * dz;
    if (d2 < r * r) {
      if (d2 > 1e-6) { const d = Math.sqrt(d2); px = qx + dx / d * r; pz = qz + dz / d * r; }
      else { const l = px - R.x0, rt = R.x1 - px, t = pz - R.z0, b = R.z1 - pz, m = Math.min(l, rt, t, b); if (m === l) px = R.x0 - r; else if (m === rt) px = R.x1 + r; else if (m === t) pz = R.z0 - r; else pz = R.z1 + r; }
    }
  }
  for (const [tx, tz, tr] of TC) { const dx = px - tx, dz = pz - tz, d = Math.hypot(dx, dz); if (d < r + tr && d > 1e-4) { px = tx + dx / d * (r + tr); pz = tz + dz / d * (r + tr); } }
  return [px, pz];
}
function movePlayer(dt) {
  const f = (keys.KeyW ? 1 : 0) - (keys.KeyS ? 1 : 0), s = (keys.KeyD ? 1 : 0) - (keys.KeyA ? 1 : 0), sy = Math.sin(P.yaw), cy = Math.cos(P.yaw);
  let mx = -sy * f + cy * s, mz = -cy * f - sy * s; const l = Math.hypot(mx, mz); if (l > 0) { mx /= l; mz /= l; }
  let sp = (keys.ShiftLeft || keys.ShiftRight) ? 7 : 4.6; const st = stats();
  if (G.tool === 5 && G.season === 3 && G.use && !G.held) sp *= .85;
  sp *= 1 - Math.min(.25, units(G.load) / 80);
  if (G.held === 'sack') sp *= .8 - .3 * clamp(units(C.sack.load) / st.sackCap, 0, 1); else if (G.held === 'barrow') sp *= .92 - .22 * clamp(units(C.barrow.load) / st.barrowCap, 0, 1);
  const c = cellAt(P.x, P.z); if (c >= 0) sp *= 1 - snow[c] * .22;
  const k = Math.min(1, 12 * dt); P.vx += (mx * sp - P.vx) * k; P.vz += (mz * sp - P.vz) * k;
  let [nx, nz] = collide(P.x + P.vx * dt, P.z + P.vz * dt, .45);
  if (!walkable(nx, nz)) { if (walkable(nx, P.z)) nz = P.z; else if (walkable(P.x, nz)) nx = P.x; else { nx = P.x; nz = P.z; } }
  P.x = nx; P.z = nz; P.speed = Math.hypot(P.vx, P.vz); P.bob += P.speed * dt * 1.7;
}

/* ---------- gameplay leaves ---------- */
function spawnLeaf() {
  let i = -1; for (let k = 0; k < MAXL; k++) if (ls[k] === 0) { i = k; break; } if (i < 0) return false;
  let x = 0, z = 0;
  for (let t = 0; t < 8; t++) { if (Math.random() < .75) { const tr = TREES[rint(0, TREES.length - 1)]; x = tr[0] + (Math.random() + Math.random() - 1) * 6; z = tr[1] + (Math.random() + Math.random() - 1) * 6; } else { x = rr(-22, 22); z = rr(-22, 22); } const c = cellAt(x, z); if (c >= 0 && type[c] !== 0) break; }
  lx[i] = clamp(x, -22.5, 22.5); lz[i] = clamp(z, -22.5, 22.5); ly[i] = rr(5.5, 8.5); lvx[i] = lvz[i] = lvy[i] = 0; lrot[i] = rr(0, 6.28); lfall[i] = rr(1.1, 1.9); ltw[i] = rr(0, 6.28); ls[i] = 1; L.spawned++; return true;
}
function hideLeaf(i) { ls[i] = 3; dummy.scale.set(0, 0, 0); dummy.updateMatrix(); leafMesh.setMatrixAt(i, dummy.matrix); }
function dumpLeaves(n) { if (n <= 0) return; L.dumped += n; income(n * LEAF_PRICE); setCargo(G.cargo + n, 'leaf'); }
const TRAILER_D = { x0: RECT.trailer.x0 - .3, x1: RECT.trailer.x1 + .3, z0: RECT.trailer.z0 - .3, z1: RECT.trailer.z1 + .3 };
function updateLeaves(dt) {
  let live = 0; const wnd = SEASONS[0].wind;
  for (let i = 0; i < MAXL; i++) {
    const s = ls[i]; if (s === 0 || s === 3) continue; live++; let rx = -Math.PI / 2, rz = 0;
    if (s === 1) {
      ly[i] -= lfall[i] * dt; lx[i] += (Math.sin(G.time * 1.7 + i) * .55 + wnd * .5) * dt; lz[i] += Math.cos(G.time * 1.3 + i * 2) * .55 * dt; ltw[i] += 3 * dt; rx += Math.sin(ltw[i]) * 1.1; rz = Math.cos(ltw[i]) * .6;
      if (ly[i] <= .03) { const c = cellAt(lx[i], lz[i]); if (c < 0 || type[c] === 0) { if (inRect(lx[i], lz[i], TRAILER_D)) dumpLeaves(1); else L.quota--; hideLeaf(i); continue; } ly[i] = .03; ls[i] = 2; }
    } else {
      const air = ly[i] > .045 || lvy[i] > 0, sp = Math.hypot(lvx[i], lvz[i]);
      if (sp > .02 || air) {
        if (air) { lvy[i] -= 4.2 * dt; ly[i] += lvy[i] * dt; lvx[i] += Math.sin(G.time * 9 + i) * .9 * dt; lvz[i] += Math.cos(G.time * 8 + i * 1.7) * .9 * dt; rx += Math.sin(G.time * 7 + i) * .7; if (ly[i] <= .03) { ly[i] = .03; lvy[i] = 0; } }
        const nx = lx[i] + lvx[i] * dt, nz = lz[i] + lvz[i] * dt;
        if (inRect(nx, nz, RECT.trailer, .25) && ly[i] < 2) { dumpLeaves(1); hideLeaf(i); continue; }
        if (inRect(nx, nz, RECT.house, .1) || inRect(nx, nz, RECT.shop, .1)) { lvx[i] *= -.25; lvz[i] *= -.25; }
        else { lx[i] = nx; lz[i] = nz; if (Math.abs(nx) > 23.3) { lx[i] = clamp(nx, -23.3, 23.3); lvx[i] *= -.3; } if (Math.abs(nz) > 23.3) { lz[i] = clamp(nz, -23.3, 23.3); lvz[i] *= -.3; } }
        const dec = Math.exp((air ? -.7 : -2.6) * dt); lvx[i] *= dec; lvz[i] *= dec; lrot[i] += sp * dt * 1.5;
      } else { lvx[i] = lvz[i] = 0; ly[i] = .03; lvy[i] = 0; }
    }
    const big = (L.spawned >= L.quota && L.quota - L.dumped - anyLoad('leaf') <= 8) ? 2.4 : 1;
    dummy.position.set(lx[i], ly[i] + (big > 1 ? .06 : 0), lz[i]); dummy.rotation.set(rx, 0, lrot[i] + rz); dummy.scale.set(big, big, big); dummy.updateMatrix(); leafMesh.setMatrixAt(i, dummy.matrix);
  }
  leafMesh.instanceMatrix.needsUpdate = true; return live;
}

/* ---------- tool actions ---------- */
function grabLeaves(dt, fx, fz) {                                           // hands: pick leaves up one by one
  G.grabAcc += dt * 5; let any = false;
  while (G.grabAcc >= 1) {
    G.grabAcc -= 1; let best = -1, bd = 1e9;
    for (let i = 0; i < MAXL; i++) { if (ls[i] !== 2) continue; const dx = lx[i] - P.x, dz = lz[i] - P.z, d = Math.hypot(dx, dz); if (d > 1.9 || d < .01 || (dx * fx + dz * fz) / d < .5 || ly[i] > .3) continue; if (d < bd) { bd = d; best = i; } }
    if (best < 0) { G.grabAcc = 0; break; } any = true;
    if (addLoad('leaf', 1)) { hideLeaf(best); burst(4200, .05, .06, 'highpass'); } else { hint('Hands full. Carry it to the trailer (E), or buy a sack.'); G.grabAcc = 0; break; }
  } return any;
}
function rake(dt, fx, fz, st) {
  let any = false; const cosA = Math.cos(st.rakeA);
  for (let i = 0; i < MAXL; i++) {
    if (ls[i] !== 2) continue; const dx = lx[i] - P.x, dz = lz[i] - P.z, d = Math.hypot(dx, dz); if (d > st.rakeR || d < .001 || (dx * fx + dz * fz) / d < cosA) continue; any = true;
    if (d < .85) { if (addLoad('leaf', 1)) hideLeaf(i); else hint('Hands full. Stand next to your sack, or empty at the trailer (E).'); } else { lvx[i] = -dx / d * 5.5; lvz[i] = -dz / d * 5.5; }
  } return any;
}
function blower(dt, fx, fz, st) {
  let any = false; const cosA = Math.cos(.62);
  for (let i = 0; i < MAXL; i++) {
    if (ls[i] !== 2) continue; const dx = lx[i] - P.x, dz = lz[i] - P.z, d = Math.hypot(dx, dz); if (d > st.blowR || d < .2 || (dx * fx + dz * fz) / d < cosA) continue;
    const k = (1.15 - d / st.blowR) * st.blowF * dt * 9; lvx[i] += fx * k + (Math.random() - .5) * k * .8; lvz[i] += fz * k + (Math.random() - .5) * k * .8; lvy[i] = Math.min(2.6, lvy[i] + k * (.5 + Math.random() * 1.6));
    const sp = Math.hypot(lvx[i], lvz[i]); if (sp > 11) { lvx[i] *= 11 / sp; lvz[i] *= 11 / sp; } any = true;
  } return any;
}
function scoopSnow(dt, fx, fz, radius, rate) {
  if (G.snowfall > 0) { hint('Wait for the snowfall to stop.'); return false; }
  const cap = capOf('snow'); if (G.load.type && G.load.type !== 'snow' && G.load.n > 0) { hint('Your hands are full of something else.'); return false; }
  const have = G.load.type === 'snow' ? G.load.n : 0; if (have >= cap - 1e-6) { hint('Full. Carry the snow to the orange marker (E).'); return false; }
  let took = 0; const room = cap - have;
  forCircle(P.x + fx * 1.6, P.z + fz * 1.6, radius, c => { if (snow[c] <= 0) return; const t = Math.min(snow[c], rate * dt, room - took); snow[c] -= t; took += t; if (snow[c] < .05) { took += snow[c]; snow[c] = 0; } mark(c); if (took >= room) return false; });
  if (took > 0) { G.load.type = 'snow'; G.load.n = have + took; snowDirty = true; G.scoopT -= dt; if (G.scoopT <= 0) { burst(1500, .14, .22); G.scoopT = .28; } } return took > 0;
}
function cutGrass(fx, fz, r, dist) {
  let n = 0;
  forCircle(P.x + fx * dist, P.z + fz * dist, r, c => { if (type[c] === 1 && !bare[c] && hgt[c] > .5) { if (!addLoad('grass', 1)) { hint('Full. Empty at the trailer (E), or use a sack nearby.'); return false; } hgt[c] = .05; G.uncut--; mark(c); n++; } });
  return n;
}
function scissorsTool(dt, fx, fz, st) { G.scisT -= dt; if (G.scisT > 0) return true; G.scisT = st.scisCD; const n = cutGrass(fx, fz, st.scisR, 1.0); if (n) burst(5500, .06, .12, 'highpass'); return true; }
function mowerTool(dt, fx, fz, st) { cutGrass(fx, fz, st.mowR, 1.55); return true; }
function seedAt(dt, fx, fz, r, cd) {
  G.seedCD -= dt; if (G.seedCD > 0) return false; if (G.seeds <= 0) { hint('Out of seed. Buy more from Gustav.'); return false; }
  let n = 0; forCircle(P.x + fx * 2, P.z + fz * 2, r, c => { if (type[c] === 1 && bare[c] && !seeded[c] && G.seeds > 0) { seeded[c] = 1; G.seeds--; n++; mark(c); } });
  if (n > 0) { G.seedCD = cd; burst(5200, .1, .12, 'highpass'); } return n > 0;
}
function waterTool(dt, fx, fz, st) {
  if (G.water <= 0) { hint('Can empty. Refill at the tap on the house wall (E).'); return false; }
  G.water = Math.max(0, G.water - .3 * dt);
  forCircle(P.x + fx * 2.4, P.z + fz * 2.4, st.canR, c => { if (type[c] === 1 && bare[c] && seeded[c] && !watered[c] && G.water >= .1) { watered[c] = 1; G.water -= .1; G.remBare--; G.regrow.push({ i: c, t: rr(2.5, 4.5), ph: 1 }); mark(c); } });
  return true;
}
function useTool(dt) {
  const st = stats(), fx = -Math.sin(P.yaw), fz = -Math.cos(P.yaw), t = G.tool; let a = false;
  G.engine = false; if (G.held) { G.working = false; return; }
  const ok = SEASON_TOOLS[G.season].includes(t);
  if (G.use && !ok) hint(`${TOOLNAME[t]} does nothing in ${SEASONS[G.season].name}.`);
  if (ok) {
    const auto = t === 6 && st.seedAuto && P.speed > .5;
    if (G.use || auto) {
      if (t === 0) { if (G.season === 0) a = grabLeaves(dt, fx, fz); else if (G.season === 1) a = scoopSnow(dt, fx, fz, .6, 1.6); else if (G.season === 2) a = seedAt(dt, fx, fz, .7, .5); }
      else if (t === 1) a = scissorsTool(dt, fx, fz, st); else if (t === 2) a = rake(dt, fx, fz, st); else if (t === 3) a = blower(dt, fx, fz, st);
      else if (t === 4) a = scoopSnow(dt, fx, fz, st.shovR, st.shovRate); else if (t === 5) a = mowerTool(dt, fx, fz, st);
      else if (t === 6) a = seedAt(dt, fx, fz, st.seedR, st.seedCD); else if (t === 7) a = waterTool(dt, fx, fz, st);
    }
  }
  G.working = a; G.engine = ok && G.use && t === 5;
}

/* ---------- interactions ---------- */
const ray = new THREE.Raycaster(); ray.far = 3.4;
function trailerLoads() { const out = []; if (G.load.n > 0 && G.load.type !== 'snow') out.push(G.load); for (const k of ['sack', 'barrow']) { const c = C[k]; if (c.own && c.load.n > 0 && (G.held === k || Math.hypot(c.x - TRAILER_C.x, c.z - TRAILER_C.z) < 7)) out.push(c.load); } return out; }
const loadValue = l => l.type === 'leaf' ? l.n * LEAF_PRICE : units(l) * GRASS_UNIT_PRICE;
function findAction() {
  const d = (x, z) => Math.hypot(P.x - x, P.z - z), c = [];
  const tl = trailerLoads(); if (tl.length) { const dd = d(TRAILER_C.x, TRAILER_C.z); if (dd < 5.5) c.push({ k: 'trailer', d: dd, label: `Empty everything into the trailer (+${money(tl.reduce((s, l) => s + loadValue(l), 0))})` }); }
  if (G.load.type === 'snow' && G.load.n > .01 && G.season === 1) { const dd = d(MARK.x, MARK.z); if (dd < MARK.r + 1.5) c.push({ k: 'marker', d: dd, label: 'Dump the snow on the pile' }); }
  if (G.season === 2 && owns(7)) { const dd = d(TAP.x, TAP.z); if (dd < 3.2) c.push({ k: 'tap', d: dd, label: 'Refill the watering can' }); }
  if (G.load.n > 0 && G.load.type !== 'snow') for (const k of ['sack', 'barrow']) { const cc = C[k]; if (cc.own && G.held !== k) { const dd = d(cc.x, cc.z); if (dd < 2.6 && canAdd(cc.load, G.load.type, cc.cap())) c.push({ k: 'put', d: dd + .2, key: k, label: `Put your load into the ${k === 'sack' ? 'sack' : 'wheelbarrow'}` }); } }
  for (const dr of DOORS) { const dd = d(dr.x, dr.z); if (dd < (dr.kind === 'gate' ? 3.6 : 2.4)) c.push({ k: 'door', d: dd + .3, door: dr, label: `${dr.t ? 'Close' : 'Open'} the ${dr.label}` }); }
  if (inRect(P.x, P.z, SHOP_IN) && d(-14.9, -9.2) < 3.2) c.push({ k: 'talk', d: .5, label: 'Talk to Gustav' });
  if (G.shelfHover) c.push({ k: 'shelf', d: .1, id: G.shelfHover.id, label: `Buy ${G.shelfHover.name} for ${money(G.shelfHover.price)}` });
  c.sort((a, b) => a.d - b.d); return c[0] || null;
}
function interact() {
  const a = findAction(); if (!a) return;
  if (a.k === 'trailer') {
    for (const l of trailerLoads()) { if (l.type === 'leaf') { L.dumped += l.n; setCargo(G.cargo + l.n, 'leaf'); } else setCargo(G.cargo + units(l) * 6, 'grass'); income(loadValue(l)); l.n = 0; l.type = null; }
    syncContainer('sack'); syncContainer('barrow'); coin();
  } else if (a.k === 'marker') { G.pileVol += G.load.n; G.load = { type: null, n: 0 }; updatePile(); burst(300, .3, .3, 'lowpass'); }
  else if (a.k === 'tap') { G.water = stats().canCap; burst(3000, .6, .2, 'highpass'); toast('Watering can refilled'); }
  else if (a.k === 'put') { const cc = C[a.key]; const fit = Math.floor((cc.cap() - units(cc.load)) / W[G.load.type] + 1e-6), mv = Math.min(fit, G.load.n); if (mv > 0) { cc.load.type = G.load.type; cc.load.n += mv; G.load.n -= mv; if (G.load.n <= 0) G.load = { type: null, n: 0 }; syncContainer(a.key); burst(2000, .15, .15); } }
  else if (a.k === 'door') { a.door.t = a.door.t ? 0 : 1; burst(220, .35, .25, 'lowpass'); }
  else if (a.k === 'talk') { say(['Welcome in! Take a look around, everything on the shelves is yours for the price.', 'Back again! What do you need?', advice()][rint(0, 2)]); shopTab = 'talk'; openModal('shop'); }
  else if (a.k === 'shelf') buyShelf(a.id);
}
function grabToggle() {
  if (G.held) { G.held = null; toast('Let go'); return; }
  let best = null, bd = 2.9; for (const k of ['sack', 'barrow']) { const c = C[k]; if (c.own) { const d = Math.hypot(P.x - c.x, P.z - c.z); if (d < bd) { bd = d; best = k; } } }
  if (best) { G.held = best; toast(best === 'sack' ? 'Dragging the sack. Look back to see it.' : 'Pushing the wheelbarrow'); }
}
function updateContainers(dt) {
  const fx = -Math.sin(P.yaw), fz = -Math.cos(P.yaw);
  if (G.held === 'sack') {
    const c = C.sack, sp = Math.hypot(P.vx, P.vz), dx = sp > .4 ? -P.vx / sp : -fx, dz = sp > .4 ? -P.vz / sp : -fz;
    const tx = P.x + dx * 1.4, tz = P.z + dz * 1.4; c.x += (tx - c.x) * Math.min(1, 6 * dt); c.z += (tz - c.z) * Math.min(1, 6 * dt); c.mesh.rotation.y = Math.atan2(P.x - c.x, P.z - c.z);
  } else if (G.held === 'barrow') { const c = C.barrow; c.x = P.x + fx * 1.55; c.z = P.z + fz * 1.55; c.mesh.rotation.y = P.yaw; }
  for (const k of ['sack', 'barrow']) { const c = C[k]; if (c.mesh) { c.mesh.position.set(c.x, snow[cellAt(c.x, c.z)] * .3 || 0, c.z); } }
}

/* ---------- per-season simulation ---------- */
function updateRegrow(dt) {
  for (let k = G.regrow.length - 1; k >= 0; k--) {
    const r = G.regrow[k]; r.t -= dt;
    if (r.ph === 1) { if (r.t <= 0) { bare[r.i] = 0; seeded[r.i] = 0; watered[r.i] = 0; hgt[r.i] = .05; r.ph = 2; r.t = 3; r.T = 3; mark(r.i); } }
    else { hgt[r.i] = .05 + .25 * (1 - Math.max(0, r.t) / r.T); mark(r.i); if (r.t <= 0) { hgt[r.i] = .3; G.regrow.splice(k, 1); } }
  }
}
function seasonUpdate(dt) {
  if (G.season === 0) {
    if (L.spawned < L.quota) { L.acc += dt * L.quota / 32; while (L.acc >= 1 && L.spawned < L.quota) { L.acc--; spawnLeaf(); } }
    const live = updateLeaves(dt), carried = anyLoad('leaf');
    if (L.spawned >= L.quota && live === 0 && carried === 0) completeRound(`Round cleared. ${L.dumped} leaves hauled away.`);
    else if (L.spawned >= L.quota && live === 0) hint('All raked up. Empty your load at the trailer (E).');
  } else if (G.season === 1) {
    if (G.snowfall > 0) { G.snowfall -= dt; G.fallAcc += dt; if (G.fallAcc > .2 || G.snowfall <= 0) { G.fallAcc = 0; const p = 1 - Math.max(0, G.snowfall) / 5; for (let i = 0; i < N * N; i++) if (snowT[i] > 0) { snow[i] = snowT[i] * p; mark(i); } snowDirty = true; } return; }
    G.tl -= dt; let V = 0; for (let i = 0; i < N * N; i++) V += snow[i]; G.V = V; const carried = G.load.type === 'snow' ? G.load.n : 0;
    if (V < .15 && carried < .05) { for (let i = 0; i < N * N; i++) if (snow[i] > 0) { snow[i] = 0; mark(i); } snowDirty = true; completeRound(`Snow cleared with ${Math.max(0, Math.ceil(G.tl))}s to spare.`); }
    else if (G.tl <= 0) { const n = rotUnderSnow(); snow.fill(0); snowT.fill(0); G.load = { type: null, n: 0 }; markAll(); toast(`Out of time! ${n} lawn patches rotted under the snow.`, 'bad'); completeRound(n ? 'Expect more reseeding in spring.' : 'Close call. The lawn survived.'); }
  } else if (G.season === 2) { updateRegrow(dt); if (G.remBare <= 0 && G.phase === 'play') completeRound('The lawn is reseeded and watered.'); }
  else {
    if (G.grow < 1) { G.grow = Math.min(1, G.grow + dt / 6); G.growAcc += dt; if (G.growAcc > .3) { G.growAcc = 0; refreshAllTufts(); } }
    const carried = anyLoad('grass');
    if (G.uncut <= 0 && carried < 1e-4) completeRound('Lawn mowed and clippings sold.'); else if (G.uncut <= 0) hint('Lawn is done. Empty your load at the trailer (E).');
  }
}

/* ---------- input ---------- */
document.addEventListener('keydown', e => {
  if (e.code === 'Tab') e.preventDefault();
  if (G.modal) { if (e.code === 'Escape') closeModal(); return; }
  keys[e.code] = true; if (!G.locked) return;
  if (e.code.startsWith('Digit')) { const n = +e.code.slice(5), ot = ownedTools(); if (n >= 1 && n <= ot.length) G.tool = ot[n - 1]; }
  if (e.code === 'KeyE') interact(); if (e.code === 'KeyF') grabToggle();
  if (e.code === 'KeyM') { AU.mute = !AU.mute; toast(AU.mute ? 'Sound off' : 'Sound on'); }
});
document.addEventListener('keyup', e => { keys[e.code] = false; });
addEventListener('blur', () => { for (const k in keys) keys[k] = false; G.use = false; });
document.addEventListener('mousemove', e => { if (!G.locked) return; P.yaw -= e.movementX * .0022; P.pitch = clamp(P.pitch - e.movementY * .0022, -1.45, 1.45); });
document.addEventListener('mousedown', e => { if (G.locked && e.button === 0) G.use = true; });
document.addEventListener('mouseup', e => { if (e.button === 0) G.use = false; });
document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('wheel', e => { if (!G.locked) return; const ot = ownedTools(), i = ot.indexOf(G.tool); G.tool = ot[(i + (e.deltaY > 0 ? 1 : ot.length - 1)) % ot.length]; }, { passive: true });
document.addEventListener('pointerlockchange', () => { G.locked = document.pointerLockElement === canvas; if (G.locked) $('pause').classList.remove('show'); else { G.use = false; for (const k in keys) keys[k] = false; showPause(); } });
document.addEventListener('pointerlockerror', showPause);
$('pause').addEventListener('click', () => { $('pause').classList.remove('show'); lockPointer(); });
$('startBtn').addEventListener('click', () => { initAudio(); $('title').classList.remove('show'); $('hud').style.display = 'block'; G.phase = 'play'; buildHotbar(); beginSeason(0); lockPointer(); });

/* ---------- HUD refresh (10 Hz) ---------- */
let hudT = 0;
function updateHUD(dt) {
  hudT -= dt; if (hudT > 0) return; hudT = .1; const S = SEASONS[G.season], st = stats();
  $('seasonName').textContent = `${S.name} · Year ${G.year}`; $('roundLine').textContent = `${S.task} ${G.round}/${G.rounds}`;
  let prog = 0, timer = '';
  if (G.season === 0) prog = L.quota > 0 ? L.dumped / L.quota : 0;
  else if (G.season === 1) { const carried = G.load.type === 'snow' ? G.load.n : 0; prog = G.snowfall > 0 ? 0 : 1 - (G.V + carried) / G.V0; if (G.snowfall > 0) timer = 'Snow is falling…'; else { const t = Math.max(0, Math.ceil(G.tl)); timer = `Clear it before the lawn rots: ${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`; } }
  else if (G.season === 2) prog = 1 - G.remBare / Math.max(1, G.bareTotal); else prog = 1 - G.uncut / G.cutTotal;
  $('progBar').style.width = (clamp(prog, 0, 1) * 100).toFixed(1) + '%'; const te = $('timer'); te.textContent = timer; te.classList.toggle('low', G.season === 1 && G.tl < 30 && G.snowfall <= 0);
  $('money').textContent = money(G.money); const de = $('debt'); de.style.display = G.debt > 0 ? 'block' : 'none'; if (G.debt > 0) de.textContent = `Debt ${money(G.debt)} · half of sales repays it`;
  const lu = units(G.load), cap = capOf(G.load.type || 'leaf'); $('handLab').textContent = G.load.type ? `Hands · ${G.load.type === 'leaf' ? 'leaves' : G.load.type === 'grass' ? 'clippings' : 'snow'}` : 'Hands';
  $('handTxt').textContent = `${lu.toFixed(1)} / ${cap}`; $('handBar').style.width = clamp(lu / cap, 0, 1) * 100 + '%';
  for (const [k, id] of [['sack', 'Sack'], ['barrow', 'Barrow']]) { const c = C[k], el = $('st' + id); el.classList.toggle('hide', !c.own); if (c.own) { const u = units(c.load); $(k + 'Txt').textContent = `${u.toFixed(1)} / ${c.cap()}`; $(k + 'Bar').style.width = clamp(u / c.cap(), 0, 1) * 100 + '%'; } }
  $('stSeed').classList.toggle('hide', G.season !== 2); $('seedTxt').textContent = `${G.seeds}`;
  $('stWater').classList.toggle('hide', G.season !== 2 || !owns(7)); $('waterTxt').textContent = `${G.water.toFixed(1)} / ${st.canCap}`; $('waterBar').style.width = clamp(G.water / st.canCap, 0, 1) * 100 + '%';
  hotSlots.forEach(([t, d]) => { d.classList.toggle('on', t === G.tool); d.classList.toggle('need', SEASON_TOOLS[G.season].includes(t)); });
  // shelf hover (crosshair raycast)
  G.shelfHover = null;
  if (G.phase !== 'title' && inRect(P.x, P.z, SHOP_IN)) { ray.setFromCamera({ x: 0, y: 0 }, camera); const hit = ray.intersectObjects(shelfRoots.filter(o => o.visible), true)[0]; if (hit) { const id = hit.object.userData.shop; if (id && !G.own[id]) { const it = ITEMS.find(i => i.id === id); G.shelfHover = { id, name: it.name, price: it.price }; } } }
  const a = (G.phase === 'play' || G.phase === 'roundEnd') ? findAction() : null, pr = $('prompt');
  let gc = null, gd = 2.9; for (const k of ['sack', 'barrow']) { const c = C[k]; if (c.own) { const dd = Math.hypot(P.x - c.x, P.z - c.z); if (G.held === k) gc = `Let go of the ${k === 'sack' ? 'sack' : 'wheelbarrow'}`; else if (!G.held && dd < gd) { gd = dd; gc = `${k === 'sack' ? 'Drag the sack' : 'Push the wheelbarrow'}`; } } }
  if (a || gc) { pr.style.display = 'block'; pr.innerHTML = (a ? `<div><kbd>E</kbd>${a.label}</div>` : '') + (gc ? `<div><kbd>F</kbd>${gc}</div>` : ''); }
  else if (G.hintT > 0 && G.hint) { pr.style.display = 'block'; pr.textContent = G.hint; } else pr.style.display = 'none';
}

/* ---------- main loop ---------- */
const clock = { last: performance.now() }, sunV = new THREE.Vector3();
function frame(now) {
  requestAnimationFrame(frame);
  const dt = Math.min(.05, (now - clock.last) / 1000); clock.last = now; const running = G.locked && !G.modal && G.phase !== 'title';
  windU.value = now * .001;
  if (running) {
    G.time += dt; movePlayer(dt); G.hintT -= dt;
    if (G.phase === 'play') { seasonUpdate(dt); if (G.phase === 'play') useTool(dt); } else if (G.phase === 'roundEnd') { G.working = false; G.engine = false; G.endTimer -= dt; if (G.endTimer <= 0) { G.phase = 'fade'; fadeTo(nextRound); } }
    updateContainers(dt); G.incT -= dt;
    if (G.incT <= 0 && G.incAcc > 0) { toast(`+${money(G.incAcc)}`, 'good'); coin(); G.incAcc = 0; if (G.incRep) { toast(`Loan repayment ${money(G.incRep)}`); G.incRep = 0; } }
    for (const k of ['sack', 'barrow']) syncContainer(k);
  } else { G.working = false; G.engine = false; }
  for (const d of DOORS) { d.a += (d.t * 1.7 - d.a) * Math.min(1, 5 * dt); d.pivots.forEach(p => { p.g.rotation.y = p.s * d.a; }); if (d.rect) d.rect.off = d.a > 1; if (d.kind === 'gate') G.gateOpen = d.a > 1; }
  if (snowDirty) { G.snowT = (G.snowT || 0) - dt; if (G.snowT <= 0) { updateSnowMesh(); snowDirty = false; G.snowT = .08; } }
  flush();

  // indoors: dim the sky light, brighten exposure
  const inside = inRect(P.x, P.z, HOUSE_IN) || inRect(P.x, P.z, SHOP_IN); G.indoor += ((inside && G.phase !== 'title' ? 1 : 0) - G.indoor) * Math.min(1, 4 * dt);
  const S = SEASONS[G.season]; hemi.intensity = S.hi * (1 - .72 * G.indoor); renderer.toneMappingExposure = S.exp * (1 + .3 * G.indoor); sun.intensity = S.si;

  // camera
  if (G.phase === 'title') { const a = now * .00007; camera.position.set(Math.cos(a) * 24, 7, Math.sin(a) * 22 + 6); camera.lookAt(0, 2, -4); }
  else { camera.position.set(P.x, 1.7 + Math.sin(P.bob) * .035 * Math.min(1, P.speed / 4), P.z); camera.rotation.set(P.pitch, P.yaw, 0); }
  sky.position.copy(camera.position);
  const tx = Math.round(camera.position.x / 2) * 2, tz = Math.round(camera.position.z / 2) * 2; sun.target.position.set(tx, 0, tz); sun.position.set(tx + S.sunPos[0] * 1.5, S.sunPos[1] * 1.5, tz + S.sunPos[2] * 1.5);
  clouds.forEach((c, i) => { c.position.x += dt * (2 + i % 3); if (c.position.x > 420) c.position.x = -420; });

  // keeper looks at you, breathes, waves a little while you talk
  { const k = keeper, dx = P.x - k.g.position.x, dz = P.z - k.g.position.z, near = Math.hypot(dx, dz) < 9 && G.phase !== 'title', want = near ? clamp(Math.atan2(dx, dz) - k.base, -1.1, 1.1) : 0;
    k.head.rotation.y += (want - k.head.rotation.y) * Math.min(1, 5 * dt); k.torso.scale.y = 1 + Math.sin(now * .002) * .01; k.arms[1].rotation.x = G.modal ? Math.sin(now * .006) * .25 - .5 : 0; }

  // tools in hand
  tools.forEach((t, i) => t.visible = (i === G.tool && G.phase !== 'title'));
  const tg = tools[G.tool];
  if (tg) {
    const b = tg.userData.base, w = G.working, tt = G.time; let ox = 0, oy = Math.sin(P.bob) * .012, oz = 0, rx = 0, rz = 0;
    if (G.tool === 0) { const bl = tg.userData.blob; const u = units(G.load), cp = capOf(G.load.type || 'leaf'), f = clamp(u / cp, 0, 1); bl.visible = f > .01; bl.scale.setScalar(.5 + f * 1.1); bl.material.color.setHex(G.load.type === 'grass' ? 0x4f9a3a : G.load.type === 'snow' ? 0xf0f4ff : 0xb4682a); if (w) { oz = -Math.abs(Math.sin(tt * 10)) * .1; oy += .03; } }
    else if (G.tool === 1 && w) { rz = Math.sin(tt * 18) * .12; }
    else if (G.tool === 2 && w) { oz = Math.sin(tt * 9) * .12; rx = Math.sin(tt * 9) * .12; } else if (G.tool === 3 && w) { oz = .03; ox = Math.sin(tt * 50) * .003; }
    else if (G.tool === 4 && w) { rx = Math.sin(tt * 6) * .25; oy -= .04; } else if (G.tool === 5 && G.engine) { oy += Math.sin(tt * 60) * .004; ox = Math.sin(tt * 47) * .003; } else if (G.tool === 7 && w) { rz = -.45; rx = -.2; }
    tg.position.set(b[0] + ox, b[1] + oy, b[2] + oz); tg.rotation.set(b[3] + rx, b[4], b[5] + rz);
  }
  if (G.held) tg && (tg.visible = false);

  // snow particles
  if (snowPts.visible) {
    const heavy = G.season === 1 && G.snowfall > 0; snowGeo.setDrawRange(0, heavy ? SNOWN : 350); const cxp = G.phase === 'title' ? 0 : P.x, czp = G.phase === 'title' ? 0 : P.z;
    for (let i = 0; i < SNOWN; i++) { const o = i * 3; snowPos[o + 1] -= (2 + (i % 5) * .4) * dt; snowPos[o] += (Math.sin(now * .0006 + i) * .4 + .6) * dt; if (snowPos[o + 1] < 0) snowPos[o + 1] += 18;
      if (snowPos[o] < cxp - 22) snowPos[o] += 44; else if (snowPos[o] > cxp + 22) snowPos[o] -= 44; if (snowPos[o + 2] < czp - 22) snowPos[o + 2] += 44; else if (snowPos[o + 2] > czp + 22) snowPos[o + 2] -= 44; }
    snowGeo.attributes.position.needsUpdate = true;
  }
  updateDecor(now * .001);
  treeObjs.forEach(t => { t.fol.rotation.z = Math.sin(now * .0009 + t.ph) * .012 * S.wind; t.fol.rotation.x = Math.cos(now * .0011 + t.ph) * .01 * S.wind; });

  // audio levels
  const w = G.working && G.phase === 'play';
  setLoop(AU.blow, w && G.tool === 3 ? .34 : 0); setLoop(AU.rake, w && (G.tool === 2 || G.tool === 0 && G.season === 0) ? .08 : 0); setLoop(AU.water, w && G.tool === 7 ? .12 : 0); setLoop(AU.mow, G.engine ? .2 : 0); setLoop(AU.wind, .035 * S.wind * (1 - G.indoor));
  if (AU.ctx && AU.og) { AU.og.gain.setTargetAtTime(AU.mute || !G.engine ? 0 : .09, AU.ctx.currentTime, .08); AU.osc.frequency.setTargetAtTime(w ? 74 : 58, AU.ctx.currentTime, .15); }

  updateHUD(dt); renderer.render(scene, camera);
}

/* ---------- boot ---------- */
applySeasonVisuals(); updateSnowMesh(); flush(); refreshAllTufts();
requestAnimationFrame(t => { clock.last = t; frame(t); });
}
</script>
</body>
</html>
